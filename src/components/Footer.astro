</footer>

<style>
  /* Cyber Footer Variables */
  .cyber-footer {
    --cyber-black: #000000;
    --cyber-dark: #0a0a0a;
    --cyber-darker: #050505;
    --cyber-gray: #1a1a1a;
    --cyber-border: #333333;
    --cyber-accent: #00ff88;
    --cyber-accent-dim: #00ff8844;
    --cyber-blue: #00d9ff;
    --cyber-white: #ffffff;
    --cyber-text: #e0e0e0;
    --cyber-text-dim: #888888;
  }

  .cyber-footer {
    position: relative;
    background: var(--cyber-black);
    padding: 4rem 0 2rem;
    border-top: 1px solid var(--cyber-border);
  }

  .footer-border-top {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cyber-accent), transparent);
    opacity: 0.5;
  }

  .footer-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Top Section - Newsletter + Links */
  .footer-top-section {
    display: grid;
    grid-template-columns: 40% 60%;
    gap: 4rem;
    margin-bottom: 4rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--cyber-border);
  }

  /* Newsletter Section */
  .newsletter-section {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .newsletter-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--cyber-white);
    font-weight: 900;
    margin-bottom: 0;
    line-height: 1.1;
  }

  .newsletter-subtitle {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--cyber-white);
    font-weight: 900;
    margin: 0 0 2rem 0;
    line-height: 1.1;
  }

  .newsletter-btn {
    display: inline-block;
    padding: 1rem 2.5rem;
    border: 1px solid var(--cyber-white);
    background: var(--cyber-white);
    color: var(--cyber-black);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    transition: all 0.3s ease;
    align-self: flex-start;
  }

  .newsletter-btn:hover {
    background: transparent;
    color: var(--cyber-white);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
  }

  .footer-heading {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--cyber-accent);
    letter-spacing: 0.15em;
    margin: 0 0 2rem 0;
    font-family: 'Courier New', monospace;
    text-transform: uppercase;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .footer-links li {
    position: relative;
  }

  .footer-links a {
    color: var(--cyber-text-dim);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.3s ease, padding-left 0.3s ease;
    display: inline-flex;
    align-items: center;
    font-family: 'Courier New', monospace;
  }

  .link-arrow {
    opacity: 0;
    margin-right: 0.5rem;
    color: var(--cyber-accent);
    transition: opacity 0.3s ease;
  }

  .footer-links a:hover {
    color: var(--cyber-accent);
  }

  .footer-links a:hover .link-arrow {
    opacity: 1;
  }

  /* Large Logo Section */
  .footer-logo-section {
    text-align: center;
    margin-bottom: 6rem;
  }

  .footer-large-logo {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
  }

  .logo-slash {
    font-size: clamp(3rem, 8vw, 5rem);
    color: var(--cyber-white);
    font-weight: 900;
    font-style: italic;
  }

  .logo-text {
    font-size: clamp(3rem, 8vw, 5rem);
    color: var(--cyber-white);
    font-weight: 900;
  }

  /* Footer Bottom */
  .footer-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 2rem;
    align-items: end;
    padding-top: 2rem;
    border-top: 1px solid var(--cyber-border);
  }

  .footer-bottom-left {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-label {
    font-size: 0.65rem;
    color: var(--cyber-text-dim);
    letter-spacing: 0.15em;
    font-family: 'Courier New', monospace;
  }

  .footer-social-icons {
    display: flex;
    gap: 0.5rem;
  }

  .social-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--cyber-border);
    background: transparent;
    color: var(--cyber-text-dim);
    text-decoration: none;
    font-size: 0.875rem;
    transition: all 0.3s ease;
  }

  .social-icon:hover {
    border-color: var(--cyber-accent);
    color: var(--cyber-accent);
  }

  .footer-bottom-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
  }

  .copyright {
    font-size: 0.75rem;
    color: var(--cyber-text-dim);
    letter-spacing: 0.1em;
    font-family: 'Courier New', monospace;
  }

  .location {
    font-size: 0.65rem;
    color: var(--cyber-text-dim);
    letter-spacing: 0.05em;
    font-family: 'Courier New', monospace;
    line-height: 1.5;
  }

  .footer-bottom-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1rem;
  }

  .status-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--cyber-accent);
    background: rgba(0, 255, 136, 0.1);
    color: var(--cyber-accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    font-family: 'Courier New', monospace;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .status-button:hover {
    background: rgba(0, 255, 136, 0.2);
  }

  .status-dot-btn {
    width: 8px;
    height: 8px;
    background: var(--cyber-accent);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--cyber-accent);
  }

  .theme-controls {
    display: flex;
    gap: 0.5rem;
  }

  .theme-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--cyber-border);
    background: transparent;
    color: var(--cyber-text-dim);
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .theme-btn:hover {
    border-color: var(--cyber-accent);
    color: var(--cyber-accent);
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .footer-top-section {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }

    .footer-bottom {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .footer-bottom-left,
    .footer-bottom-center,
    .footer-bottom-right {
      align-items: center;
      text-align: center;
    }

    .footer-social-icons {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .footer-top-section {
      gap: 2.5rem;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .newsletter-section {
      text-align: center;
      align-items: center;
    }

    .newsletter-btn {
      align-self: center;
    }

    .footer-logo-section {
      margin-bottom: 4rem;
    }
  }

  @media (max-width: 480px) {
    .cyber-footer {
      padding: 3rem 0 2rem;
    }

    .footer-container {
      padding: 0 1rem;
    }

    .footer-grid {
      gap: 2rem;
      margin-bottom: 4rem;
    }

    .newsletter-title,
    .newsletter-subtitle {
      font-size: 1.75rem;
    }

    .logo-slash,
    .logo-text {
      font-size: 2.5rem;
    }

    .theme-controls {
      justify-content: center;
    }
  }
</style>
