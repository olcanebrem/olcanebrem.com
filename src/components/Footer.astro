---
// src/components/Footer.astro
import { footerCards } from './FooterCardData'; // Yolu kendi projenize göre güncelleyin
---
<!-- ID'yi "revealed-content-footer" gibi daha belirgin bir şey yapabiliriz
     ya da doğrudan .footer div'inin içine yerleştirebiliriz.
     Şimdilik mevcut ID'si "footer" kalsın ama stilini BaseLayout'tan kontrol edelim. -->
<div class="footer-container">
  <div class="footer-content">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap justify-center gap-6">
        {footerCards.map(card => (
          <a href={card.link} target="_blank" rel="noopener" class="group flex-1 min-w-[200px] max-w-xs p-5 flex flex-col items-center transition-transform duration-200 hover:scale-105 hover:z-10 cursor-pointer" style="background-color: var(--md-sys-color-surface-container, #F3EDF7); box-shadow: var(--md-sys-elevation-level1); border-radius: var(--md-sys-shape-corner-extra-large);">
            <img src={card.img} alt={card.title + ' logo'} class="w-16 h-16 object-contain mb-4 rounded" loading="lazy" />
            <h3 class="text-lg font-bold mb-1" style="color: var(--md-sys-color-on-surface, #1D1B20);">{card.title}</h3>
            <p class="text-sm text-center mb-2" style="color: var(--md-sys-color-on-surface-variant, #49454F);">{card.desc}</p>
          </a>
        ))}
      </div>
      <div class="mt-8 flex flex-col items-center gap-3">
        <!-- Social Media Links -->
        <div class="flex flex-wrap justify-center gap-2">
          <a href="https://github.com/olcanebrem" target="_blank" rel="noopener" class="p-1.5 rounded-lg hover:bg-surface-container-hover transition-all hover:scale-110" title="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
          <a href="https://linkedin.com/in/olcanebrem" target="_blank" rel="noopener" class="p-1.5 rounded-lg hover:bg-surface-container-hover transition-all hover:scale-110" title="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a href="https://twitter.com/olcanebrem" target="_blank" rel="noopener" class="p-1.5 rounded-lg hover:bg-surface-container-hover transition-all hover:scale-110" title="Twitter">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
            </svg>
          </a>
          <a href="https://instagram.com/olcanebrem" target="_blank" rel="noopener" class="p-1.5 rounded-lg hover:bg-surface-container-hover transition-all hover:scale-110" title="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href="https://youtube.com/@olcanebrem" target="_blank" rel="noopener" class="p-1.5 rounded-lg hover:bg-surface-container-hover transition-all hover:scale-110" title="YouTube">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
              <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
            </svg>
          </a>
          <a href="mailto:olcanebrem@gmail.com" target="_blank" rel="noopener" class="p-1.5 rounded-lg hover:bg-surface-container-hover transition-all hover:scale-110" title="Email">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </a>
        </div>

        <!-- Site Links -->
        <div class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-xs">
          <a href="/sitemap.xml" class="hover:underline opacity-80 hover:opacity-100">Sitemap</a>
          <a href="/rss.xml" class="hover:underline opacity-80 hover:opacity-100">RSS</a>
          <a href="/privacy" class="hover:underline opacity-80 hover:opacity-100">Gizlilik</a>
          <a href="/terms" class="hover:underline opacity-80 hover:opacity-100">Şartlar</a>
          <a href="/about" class="hover:underline opacity-80 hover:opacity-100">Hakkında</a>
          <a href="/contact" class="hover:underline opacity-80 hover:opacity-100">İletişim</a>
        </div>
      </div>
      <div class="mt-8 text-center text-xs">
        © {new Date().getFullYear()} Bu site Creative Commons CC BY lisansı altında paylaşıma sunulmuştur. Olcan Ebrem tarafından tasarlandı.
      </div>
    </div>
  </div>
</div>

<style>
  .footer-container {
    position: relative;
    padding-top: 2rem;
    width: 100%;
    height: 100%;
    background-color: var(--md-sys-color-surface-container-highest);
    box-shadow: var(--md-sys-elevation-level1);
  }

  .footer-content {
    width: 100%;
    height: 100%;
    padding: 4rem 2rem;
    border-top-left-radius: var(--md-sys-shape-corner-extra-large);
    border-top-right-radius: var(--md-sys-shape-corner-extra-large);
    color: var(--md-sys-color-on-surface-container-highest);
  }

  @media (max-width: 768px) {
    .footer-container {
      border-top-left-radius: var(--md-sys-shape-corner-extra-large);
      border-top-right-radius: var(--md-sys-shape-corner-extra-large);
    }

    .footer-content {
      padding: 2rem 1rem;
    }
  }
</style>

