---
const menuItems = [
  {
    title: 'Inbox',
    icon: 'mail',
    badge: '24',
    active: true
  },
  {
    title: 'Outbox',
    icon: 'send',
    badge: '3'
  },
  {
    title: 'Favorites',
    icon: 'favorite',
    badge: '12'
  },
  {
    title: 'Trash',
    icon: 'delete',
    divider: true
  },
  {
    title: 'Labels',
    icon: 'label',
    children: [
      { title: 'Personal', color: 'bg-purple-500' },
      { title: 'Work', color: 'bg-blue-500' },
      { title: 'Family', color: 'bg-green-500' }
    ]
  },
  {
    title: 'Settings',
    icon: 'settings'
  },
  {
    title: 'Help & Feedback',
    icon: 'help'
  }
];

const currentSection = 'Inbox';
---

<aside 
  id="sidebar"
  onclick="event.stopPropagation()"
  class="fixed top-0 left-0 h-screen w-[360px] bg-surface text-on-surface transform -translate-x-full transition-transform duration-300 ease-emphasized z-40 elevation-2 overflow-hidden will-change-transform"
  onmouseenter="sidebarMouseIn()"
  onmouseleave="sidebarMouseOut()"
>
  <div class="h-full flex flex-col">
    <!-- Header -->
    <div class="h-14 px-4 flex items-center justify-between border-b border-outline/[0.08]">
      <h1 class="text-title-large">Mail</h1>
      <button 
        id="closeSidebar"
        class="m3-icon-button"
        aria-label="Close navigation drawer"
      >
        <span class="material-symbols-outlined">close</span>
        <div class="m3-state-layer" />
      </button>
    </div>

    <!-- Navigation List -->
    <nav class="flex-1 overflow-y-auto">
      <div class="p-3 space-y-1">
        {menuItems.map((item) => (
          <div class="relative">
            <button
              class:list={[
                'm3-nav-item group w-full transition-all duration-300',
                { 'is-active': item.title === currentSection }
              ]}
              aria-expanded={item.children ? 'false' : undefined}
              onclick={item.children ? `toggleSubmenu('${item.title}')` : undefined}
            >
              <span class="material-symbols-outlined">{item.icon}</span>
              <span class="flex-1">{item.title}</span>
              {item.badge && (
                <span class="m3-badge">{item.badge}</span>
              )}
              {item.children && (
                <span class="material-symbols-outlined transition-transform duration-300 group-aria-expanded:rotate-180">
                  expand_more
                </span>
              )}
              <div class="m3-state-layer" />
            </button>

            {item.children && (
              <div
                class="submenu pl-8 space-y-1 hidden transition-[max-height,opacity] duration-300 ease-emphasized"
                id={`submenu-${item.title}`}
              >
                {item.children.map((child) => (
                  <button class="m3-nav-item relative">
                    <span class={`w-2 h-2 rounded-full ${child.color}`} />
                    <span class="flex-1">{child.title}</span>
                    <div class="m3-state-layer" />
                  </button>
                ))}
              </div>
            )}

            {item.divider && (
              <div class="my-2 border-t border-outline/[0.08]" />
            )}
          </div>
        ))}
      </div>
    </nav>
  </div>
</aside>

<script>
let sidebarOpen = false;
const sidebar = document.getElementById('sidebar');

function openSidebar() {
  if (!sidebarOpen) {
    sidebar.classList.remove('-translate-x-full');
    sidebar.classList.add('translate-x-0');
    sidebarOpen = true;
  }
}
function closeSidebar() {
  if (sidebarOpen) {
    sidebar.classList.remove('translate-x-0');
    sidebar.classList.add('-translate-x-full');
    sidebarOpen = false;
  }
}
function sidebarMouseIn() {
  openSidebar();
}
function sidebarMouseOut() {
  closeSidebar();
}
window.addEventListener('mousemove', (e) => {
  if (e.clientX <= 50 && !sidebarOpen) {
    openSidebar();
  }
  // Eğer sidebar açıksa ve mouse sidebar dışında ise kapat
  if (sidebarOpen && e.clientX > 360) {
    closeSidebar();
  }
});
</script>


<!-- Scrim -->
<div
  id="sidebarOverlay"
  class="fixed top-0 left-[360px] h-[100vh] right-0 bg-scrim z-30 hidden transition-opacity duration-300 ease-emphasized opacity-0"
></div>

<style>
  .text-title-large {
    font-size: 1.375rem;
    line-height: 1.75rem;
    font-weight: 400;
  }

  .elevation-2 {
    box-shadow: var(--md-sys-elevation-level2, 0px 4px 8px rgba(0, 0, 0, 0.15));
  }

  .m3-nav-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 3.5rem;
    padding: 0 1rem;
    border-radius: 1.75rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.1px;
    transition: all 0.3s ease;
    background: transparent;
    border: 2px solid transparent;
  }

  .m3-nav-item:hover {
    background: var(--md-sys-color-surface-variant, #ece6f0);
    color: var(--md-sys-color-on-surface, #1c1b1f);
    border-color: var(--md-sys-color-secondary-container, #d0bcff);
    box-shadow: 0 2px 8px rgba(60, 60, 60, 0.08);
  }

  .m3-nav-item:active {
    background: var(--md-sys-color-surface-variant);
    border-color: var(--md-sys-color-secondary-container);
    box-shadow: 0 2px 12px rgba(60, 60, 60, 0.14);
  }

  .m3-nav-item.is-active {
    color: var(--md-sys-color-on-secondary-container);
    background-color: var(--md-sys-color-secondary-container);
    border-color: var(--md-sys-color-secondary-container);
  }

  .m3-icon-button {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    color: var(--md-sys-color-on-surface-variant);
    overflow: hidden;
  }

  .m3-icon-button:hover .m3-state-layer {
    background-color: rgba(0, 0, 0, 0.08);
  }

  .m3-icon-button:active .m3-state-layer {
    background-color: rgba(0, 0, 0, 0.12);
  }

  .m3-badge {
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    background-color: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1rem;
  }

  .m3-state-layer {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    transition: background-color 0.2s ease;
  }

  .ease-emphasized {
    transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }

  .submenu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s ease-out;
  }
  .submenu.show {
    max-height: 200px;
  }
  .submenu.hidden {
    max-height: 0;
    overflow: hidden;
    transition: max-height 1.5s ease-out;
}
</style>

<script is:inline>
  function setupSidebar() {
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');
    const closeBtn = document.getElementById('closeSidebar');

    if (!sidebar || !overlay || !closeBtn) return;

    function closeSidebar() {
      sidebar.classList.remove('translate-x-0');
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('hidden');
      overlay.classList.remove('opacity-100');
      overlay.classList.add('opacity-0');
      document.body.classList.remove('overflow-hidden');
    }

    function openSidebar() {
      sidebar.classList.remove('-translate-x-full');
      sidebar.classList.add('translate-x-0');
      overlay.classList.remove('hidden');
      overlay.classList.remove('opacity-0');
      overlay.classList.add('opacity-100');
      document.body.classList.add('overflow-hidden');
    }

    closeBtn.addEventListener('click', closeSidebar);
    overlay.addEventListener('click', closeSidebar);

    window.toggleSidebar = function () {
      if (sidebar.classList.contains('-translate-x-full')) {
        openSidebar();
      } else {
        closeSidebar();
      }
    };
  }

  function toggleSubmenu(title) {
    const submenu = document.getElementById(`submenu-${title}`);
    const button = submenu?.previousElementSibling;

    if (submenu && button) {
      const isExpanded = submenu.classList.contains('show');

      document.querySelectorAll('.submenu.show').forEach((el) => {
        if (el !== submenu) {
          el.classList.remove('show');
          el.classList.add('hidden');
        }
      });

      submenu.classList.toggle('hidden');
      submenu.classList.toggle('show');
      button.setAttribute('aria-expanded', (!isExpanded).toString());
    }
  }

  setupSidebar();
  document.addEventListener('astro:page-load', setupSidebar);
</script>
