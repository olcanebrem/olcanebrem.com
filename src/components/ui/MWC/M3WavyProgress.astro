---
// Import global styles to ensure CSS variables are available
import '../../../styles/globals.css';

// Props: progress, size, strokeWidth, baseColor, progressColor,
// waveAmplitude, waveFrequency, waveSpeed, isIndeterminate,
// showThumb, thumbColor, thumbSize

const {
  progress = 0,
  size = 100,
  strokeWidth = 8,
  baseColor = 'var(--md-sys-color-surface-container-highest, #E0E0E0)',
  progressColor = 'var(--md-sys-color-primary, #6200EE)',
  waveAmplitude = 3,
  waveFrequency = 10,
  waveSpeed = 0.5,
  isIndeterminate = false,
  showThumb = false,
  thumbColor = 'var(--md-sys-color-primary, #6200EE)',
  thumbSize = 12,
} = Astro.props;

const radius = (size - strokeWidth) / 2;
// Düz daire çevresi, başlangıçta bir referans olarak kalabilir ama asıl yol uzunluğu dinamik olacak
const baseCircumference = 2 * Math.PI * radius;
const uniqueId = `wavy-progress-${Math.random().toString(36).substr(2, 9)}`;
const thumbId = `wavy-thumb-${uniqueId}`;
const startAngleRad = -Math.PI / 2; // Üst-orta başlangıç
const padding = waveAmplitude * 2; // Dalga genliğinin 2 katı kadar padding
const paddedSize = size + padding * 2; // SVG boyutuna padding ekle
---

<div class:list={["wavy-progress-container", { indeterminate: isIndeterminate }]} style={`--size: ${size}px; --stroke-width: ${strokeWidth}px;`}>
  <svg
    width={size}
    height={size}
    viewBox={`-${padding} -${padding} ${paddedSize} ${paddedSize}`}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={isIndeterminate ? undefined : progress}
    role="progressbar"
  >
    {/* İz Yolu (Track) */}
    <path
      class="track"
      d={`M ${size/2} ${strokeWidth/2} a ${radius} ${radius} 0 1 1 0 ${radius*2} a ${radius} ${radius} 0 1 1 0 -${radius*2}`}
      fill="none"
      stroke={baseColor}
      stroke-width={strokeWidth}
    />
    {/* İlerleme Yolu (Progress) */}
    <path
      class="progress"
      id={uniqueId}
      fill="none"
      stroke={progressColor}
      stroke-width={strokeWidth}
      stroke-linecap={showThumb ? "butt" : "round"}
      <!-- stroke-dasharray ve stroke-dashoffset JS tarafından dinamik olarak ayarlanacak -->
    />
    {/* Thumb */}
    {showThumb && (
      <circle
        class="thumb"
        id={thumbId}
        r={thumbSize / 2}
        fill={thumbColor}
      />
    )}
  </svg>
</div>

<script define:vars={{ uniqueId, thumbId, radius, size, strokeWidth, waveAmplitude, waveFrequency, waveSpeed, progress, baseCircumference, isIndeterminate, showThumb, thumbSize, startAngleRad, progressColor }}>
  const progressPath = document.getElementById(uniqueId);
  const thumbElement = showThumb ? document.getElementById(thumbId) : null;

  if (!progressPath) {
    console.error('Progress path not found');
  }

  const centerX = size / 2;
  const centerY = size / 2;
  let animationFrameId = null;
  let startTime = null;

  // Dalgalı yolun 'd' özelliğini ve son noktasını üretir
  function generateWavyPathData(currentProgressFraction /*0-1*/, phaseOffset) {
    const points = [];
    const numSegments = Math.max(100, Math.floor(baseCircumference / 2.5)); // Segment sayısı
    const endAngle = startAngleRad + currentProgressFraction * 2 * Math.PI;
    let lastX, lastY;

    for (let i = 0; i <= numSegments * currentProgressFraction; i++) {
      const angle = startAngleRad + (i / numSegments) * currentProgressFraction * 2 * Math.PI;
      const r = radius + waveAmplitude * Math.sin(angle * waveFrequency + phaseOffset);
      const x = centerX + r * Math.cos(angle);
      const y = centerY + r * Math.sin(angle);

      if (i === 0) {
        points.push(`M ${x.toFixed(3)} ${y.toFixed(3)}`);
      } else {
        points.push(`L ${x.toFixed(3)} ${y.toFixed(3)}`);
      }
      lastX = x;
      lastY = y;
    }
    return { pathString: points.join(' ') || `M 0 0`, lastX, lastY }; // Boş path gönderme
  }


  function animate(timestamp) {
    if (!startTime) startTime = timestamp;
    const elapsedTime = timestamp - startTime;
    const phase = (elapsedTime / 1000 * waveSpeed * 2 * Math.PI) % (2 * Math.PI); // Dalga hareketi için faz

    if (isIndeterminate) {
      // 1. Adım: Tam bir dalgalı daire yolu çiz
      const { pathString } = generateWavyPathData(1, phase); // Daima tam daire için path üret
      if(progressPath.getAttribute('d') !== pathString) { // Sadece path değiştiyse güncelle (performans)
          progressPath.setAttribute('d', pathString);
      }

      // 2. Adım: Yolun gerçek uzunluğunu al (bu, dalgalanmaya göre değişebilir)
      // Not: getTotalLength() çağrısı her frame'de maliyetli olabilir.
      // Eğer dalga genliği ve frekansı sabitse, bu değer çok fazla değişmeyebilir.
      // Ama faz animasyonu nedeniyle dalga "aktığı" için, yolun şekli değişmese de
      // getTotalLength() sonucu sabit kalacaktır. Bu yüzden sadece bir kez almak yetebilir
      // eğer pathString'i her frame değiştirmiyorsak. Ama dalga fazı path'i değiştirmez, sadece görünümünü.
      // Path'in geometrisi (d atribütü) faz ile değişmediği için, getTotalLength() bir kez alınabilir.
      // Ancak biz burada fazı path geometrisine dahil ediyoruz (generateWavyPathData içinde).
      // Bu durumda d her frame değişir.
      const actualPathLength = progressPath.getTotalLength();

      if (actualPathLength === 0) { // Path henüz çizilmemiş veya geçersizse
        animationFrameId = requestAnimationFrame(animate);
        return;
      }

      // 3. Adım: stroke-dasharray ve stroke-dashoffset ayarla
      const indeterminatePortion = 0.5; // Göstergenin, toplam yolun % kaçı olacağı (0.25'ten 0.4'e çıkarıldı)
      const segmentLength = actualPathLength * indeterminatePortion;
      const gapLength = actualPathLength * (1 - indeterminatePortion);
      progressPath.style.strokeDasharray = `${segmentLength} ${gapLength}`;

      // Dönme animasyonu için (0-1 arası ilerleme)
      // Örneğin, 2 saniyede bir tam tur (waveSpeed ile ayarlanabilir)
      const rotationDuration = 1000 / waveSpeed;
      const rotationProgress = (elapsedTime % rotationDuration) / rotationDuration;

      // strokeDashoffset'i animasyonla değiştirerek segmenti döndür
      // Negatif offset, deseni yolun başlangıcına doğru kaydırır (saat yönünde hareket gibi)
      progressPath.style.strokeDashoffset = `${-(rotationProgress * actualPathLength)}`;

      // 4. Adım: Thumb pozisyonu (eğer gösteriliyorsa)
      if (showThumb && thumbElement) {
        // Görünen segmentin sonu, (rotationProgress + indeterminatePortion) noktasındadır.
        // Ancak offset negatif olduğu için, segmentin sonu: (1 - rotationProgress + indeterminatePortion) % 1 gibi düşünülebilir.
        // Veya daha basit: segment (-rotationProgress * L) 'den başlar ve (-rotationProgress * L + S) 'de biter.
        // getPointAtLength, 0'dan L'ye pozitif değerler bekler.
        let thumbPositionLength = (segmentLength - (rotationProgress * actualPathLength)) % actualPathLength;
        // Eğer thumbPositionLength negatif çıkarsa, actualPathLength ekleyerek pozitife çevir.
         while(thumbPositionLength < 0) thumbPositionLength += actualPathLength;


        const point = progressPath.getPointAtLength(thumbPositionLength);
        thumbElement.setAttribute('cx', point.x.toFixed(3));
        thumbElement.setAttribute('cy', point.y.toFixed(3));
      }

    } else { // Belirli (Determinate) Mod
      const currentProgressFraction = progress / 100;
      const { pathString, lastX, lastY } = generateWavyPathData(currentProgressFraction, phase);
      if(progressPath.getAttribute('d') !== pathString) {
        progressPath.setAttribute('d', pathString);
      }

      // Belirli modda dasharray/dashoffset'e gerek yok, çünkü path zaten doğru uzunlukta çiziliyor.
      // Eğer kısmi path yerine tam path çizip dashoffset ile gösteriyorsanız, o zaman gerekir.
      // Mevcut generateWavyPathData zaten kısmi path üretiyor.
      progressPath.style.strokeDasharray = 'none'; // veya actualPathLength
      progressPath.style.strokeDashoffset = '0';

      if (showThumb && thumbElement && lastX !== undefined) {
        thumbElement.setAttribute('cx', lastX.toFixed(3));
        thumbElement.setAttribute('cy', lastY.toFixed(3));
      }
    }

    animationFrameId = requestAnimationFrame(animate);
  }

  function init() {
    // Indeterminate mod için, path'i ilk kez oluşturup getTotalLength'i alabiliriz.
    // Ama faz animasyonu ile path her frame değişeceği için, getTotalLength animate içinde kalmalı.
    // Path'i ilk kez ayarlamak, getPointAtLength'in ilk frame'de çalışmasını sağlar.
    if (isIndeterminate) {
        const { pathString } = generateWavyPathData(1, 0); // Başlangıç fazı ile tam daire
        progressPath.setAttribute('d', pathString);
    } else {
        const { pathString, lastX, lastY } = generateWavyPathData(progress / 100, 0);
        progressPath.setAttribute('d', pathString);
        if (showThumb && thumbElement && lastX !== undefined) {
            thumbElement.setAttribute('cx', lastX.toFixed(3));
            thumbElement.setAttribute('cy', lastY.toFixed(3));
        }
    }
  }


  function startAnimation() {
    if (animationFrameId) {
      cancelAnimationFrame(animationFrameId);
    }
    startTime = null; // Animasyonu her başlattığında zamanı sıfırla
    init(); // Path'i ilk duruma getir
    animationFrameId = requestAnimationFrame(animate);
  }

  startAnimation();

  // Astro yaşam döngüsü olayları
  document.addEventListener('astro:page-load', () => {
    // Eğer prop'lar değişmişse startAnimation'ın güncel prop'ları kullanması gerekir.
    // Astro'da client script'ler prop değişikliklerini doğrudan "reaktif" olarak almaz.
    // Component yeniden render edildiğinde bu script baştan çalışır.
    // Bu yüzden startAnimation() burada genellikle doğru çalışır.
    startAnimation();
  });

  document.addEventListener('astro:before-swap', () => {
    if (animationFrameId) {
      cancelAnimationFrame(animationFrameId);
    }
  });

</script>

<style>
  .wavy-progress-container {
    display: inline-block;
    width: var(--size);
    height: var(--size);
    position: relative;
    overflow: visible; /* SVG'nin taşan kısımlarını göster */
  }
  .progress {
    /* Belirli modda stroke-dashoffset değişimi için (eğer kullanılıyorsa) */
    /* transition: stroke-dashoffset 0.3s ease-out; */
  }
</style>