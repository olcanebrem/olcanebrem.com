---
import '@material/web/all.js';

const newComponents = [
{
    name: "Chips (Çipler)",
    description: "Kullanıcıların giriş yapmasına, seçim yapmasına veya eylemleri filtrelemesine olanak tanıyan kompakt elemanlar.",
    m3Link: "https://m3.material.io/components/chips/overview",
    exampleHtml: `
      <md-chip-set aria-label="Örnek Çipler">
        <md-assist-chip label="Yardımcı Çip"></md-assist-chip>
        <md-filter-chip label="Filtre Çipi" selected></md-filter-chip>
        <md-input-chip label="Giriş Çipi" selected remove-only></md-input-chip>
        <md-suggestion-chip label="Öneri Çipi"></md-suggestion-chip>
      </md-chip-set>
    `
  },
  {
    name: "Buttons (Düğmeler)",
    description: "Kullanıcıların eylem yapmasını ve seçim yapmasını sağlayan temel etkileşim elemanları.",
    m3Link: "https://m3.material.io/components/buttons/overview",
    exampleHtml: `
      <div style="display: flex; gap: 1rem; align-items: center;">
        <md-filled-button>Dolgulu Düğme</md-filled-button>
        <md-outlined-button>Çerçeveli Düğme</md-outlined-button>
      </div>
    `
  },
  {
    name: "Other Components (Diğer Bileşenler)",
    description: "Sık kullanılan diğer Material 3 bileşenleri: Icon Button, Switch ve Text Field.",
    m3Link: "https://m3.material.io/components", // Genel bileşenler sayfasına link
    exampleHtml: `
      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <md-icon-button aria-label="Favorilere ekle">
            <md-icon>favorite</md-icon>
          </md-icon-button>
          <span>Icon Button (Favori)</span>
        </div>
        
        <div style="display: flex; align-items: center; gap: 1rem;">
          <md-switch selected></md-switch>
          <span>Switch (Açık/Kapalı)</span>
        </div>
        
        <md-outlined-text-field 
          label="Metin Girin"
          supporting-text="Yardımcı metin burada"
          style="max-width: 1600px;"
        ></md-outlined-text-field>
      </div>
    `
  },
  {
    name: "Badges (Rozetler)",
    description: "Bildirim sayılarını veya diğer küçük bilgi parçalarını göstermek için kullanılır.",
    m3Link: "https://m3.material.io/components/badges/overview",
    exampleHtml: `<div style="position:relative; display:inline-block; margin:10px;">
                    <md-filled-button>Mesajlar</md-filled-button>
                    <div style="position:absolute; top:-8px; right:-8px; background:var(--md-sys-color-error, red); color:var(--md-sys-color-on-error, white); border-radius:10px; min-width:20px; height:20px; padding: 0 4px; display:flex; align-items:center; justify-content:center; font-size:0.75rem; line-height:1;">3</div>
                  </div>
                  <p><i>Not: MWC'de henüz doğrudan <code style='font-family:monospace'><md-badge></code> yoktur. Genellikle CSS ile veya diğer bileşenlerle oluşturulur.</i></p>`
  },
  {
    name: "Bottom Sheets (Alt Sayfalar)",
    description: "Ekranın altından kayarak açılan, ek içerik veya eylemler sunan yüzeyler.",
    m3Link: "https://m3.material.io/components/bottom-sheets/overview",
    types: ["Standard Bottom Sheet", "Modal Bottom Sheet"],
    exampleHtml: `<p><i>MWC'de doğrudan <code style='font-family:monospace'><md-bottom-sheet></code> bileşeni henüz bulunmamaktadır. Genellikle <code style='font-family:monospace'><md-dialog></code> ile benzer bir mantıkla veya özel olarak oluşturulur.</i></p>
                  <md-filled-button>Örnek Buton</md-filled-button>
                  <div style="display:flex; align-items: center; gap: 8px; margin-top:10px;"> <md-checkbox touch-target="wrapper"></md-checkbox> Kabul Et </div>`
  },
  {
    name: "Date Pickers (Tarih Seçiciler)",
    description: "Kullanıcıların bir tarih veya tarih aralığı seçmesini sağlar.",
    m3Link: "https://m3.material.io/components/date-pickers/overview",
    types: ["Date Input", "Date Range Picker"],
    exampleHtml: `<p><i>MWC'de <code style='font-family:monospace'><md-date-picker></code> bileşeni henüz tam olarak mevcut değildir veya deneysel aşamadadır. Alternatif kütüphaneler veya özel çözümler gerekebilir.</i></p>`
  },
  {
    name: "Dialogs (Diyaloglar)",
    description: "Kullanıcıyı bilgilendiren veya bir karar vermesini gerektiren küçük pencereler.",
    m3Link: "https://m3.material.io/components/dialogs/overview",
    types: ["Basic Dialog", "Full-screen Dialog"],
    exampleHtml: `<md-filled-button id="open-dialog-btn-page">Diyalog Aç</md-filled-button>
                  <md-dialog id="example-dialog-page">
                    <div slot="headline">Diyalog Başlığı</div>
                    <form slot="content" id="form-id-page" method="dialog">
                      Bu bir diyalog içeriğidir. <br/>
                      <label style="display: block; margin-top: 10px;">
                        İsim: <input type="text" style="border: 1px solid var(--md-sys-color-outline); padding: 8px; border-radius: 4px; width: calc(100% - 16px); margin-top: 4px;">
                      </label>
                    </form>
                    <div slot="actions">
                      <md-outlined-button form="form-id-page" value="cancel">İptal</md-outlined-button>
                      <md-filled-button form="form-id-page" value="ok" autofocus>Tamam</md-filled-button>
                    </div>
                  </md-dialog>`
  },
  {
    name: "Lists (Listeler)",
    description: "Dikey olarak düzenlenmiş metin ve/veya resim satırlarından oluşan sürekli bir grup.",
    m3Link: "https://m3.material.io/components/lists/overview",
    exampleHtml: `<ul style="list-style:none; padding:0; border:1px solid var(--md-sys-color-outline-variant); border-radius:4px; max-width:300px;">
                    <li style="padding:12px 16px; border-bottom:1px solid var(--md-sys-color-outline-variant);">Liste Öğesi 1</li>
                    <li style="padding:12px 16px; border-bottom:1px solid var(--md-sys-color-outline-variant);">Liste Öğesi 2</li>
                    <li style="padding:12px 16px;">Liste Öğesi 3</li>
                  </ul>
                  <p><i>Not: MWC'de henüz spesifik <code style='font-family:monospace'><md-list></code> ve <code style='font-family:monospace'><md-list-item></code> bileşenleri tam oturmamıştır. Genellikle standart HTML ve CSS (M3 tokenları ile) veya <code style='font-family:monospace'><md-item></code> gibi daha genel bileşenlerle oluşturulur.</i></p>`
  },
  {
    name: "Menus (Menüler)",
    description: "Kullanıcının bir dizi seçenek arasından seçim yapabileceği geçici yüzeyler.",
    m3Link: "https://m3.material.io/components/menus/overview",
    types: ["Dropdown Menu", "Exposed Dropdown Menu"],
    exampleHtml: `<p><i>MWC'de <code style='font-family:monospace'><md-menu></code> ve ilgili bileşenler mevcuttur ancak kullanımı biraz daha karmaşıktır ve genellikle bir tetikleyici (örn: button) ile birlikte kullanılır. Basit bir örnek için MWC dokümantasyonuna bakınız.</i></p>
                  <md-filled-button id="menu-anchor">Menüyü Aç</md-filled-button>
                  <md-menu anchor="menu-anchor">
                    <md-menu-item headline="Kes"></md-menu-item>
                    <md-menu-item headline="Kopyala"></md-menu-item>
                    <md-menu-item headline="Yapıştır"></md-menu-item>
                  </md-menu>
                  <p><i>Not: Menülerin çalışması için genellikle JavaScript ile <code>.show()</code> veya <code>.open = true</code> gibi tetiklemeler gerekir.</i></p>`
  },
  {
    name: "Progress Indicators (İlerleme Göstergeleri)",
    description: "Bir işlemin ne kadar sürede tamamlanacağını veya belirsiz bir bekleme süresini gösterir.",
    m3Link: "https://m3.material.io/components/progress-indicators/overview",
    types: ["Linear Progress Indicator", "Circular Progress Indicator"],
    exampleHtml: `<div style="margin-bottom:10px;">Dairesel (Belirli): <md-circular-progress value="0.75" aria-label="Yükleniyor"></md-circular-progress></div>
                  <div style="margin-bottom:10px;">Dairesel (Belirsiz): <md-circular-progress indeterminate aria-label="İşleniyor"></md-circular-progress></div>
                  <div style="margin-bottom:10px;">Doğrusal (Belirli): <md-linear-progress value="0.5" buffer="0.8" aria-label="Yükleme ilerlemesi"></md-linear-progress></div>
                  <div>Doğrusal (Belirsiz): <md-linear-progress indeterminate aria-label="İşlem sürüyor"></md-linear-progress></div>`
  },
  {
    name: "Segmented Buttons (Bölümlenmiş Düğmeler)",
    description: "Kullanıcıların seçenekler arasında geçiş yapmasına veya tek bir seçenek seçmesine olanak tanır.",
    m3Link: "https://m3.material.io/components/segmented-buttons/overview",
    types: ["Single-select", "Multi-select"],
    exampleHtml: `<p><i>MWC'de <code style='font-family:monospace'><md-segmented-button-set></code> ve <code style='font-family:monospace'><md-segmented-button></code> bileşenleri mevcuttur. Kullanımı için MWC dokümantasyonuna bakınız.</i></p>
                  <p><i>Örnek (henüz MWC'de tam olarak bu yapıda olmayabilir, genel konsept):</i></p>
                  <div style="display:flex; border: 1px solid var(--md-sys-color-outline); border-radius: 20px; overflow:hidden; width:fit-content;">
                    <button style="padding:8px 16px; background: var(--md-sys-color-surface-variant); border:none; color: var(--md-sys-color-on-surface-variant);">Sol</button>
                    <button style="padding:8px 16px; background: var(--md-sys-color-secondary-container); border:none; color: var(--md-sys-color-on-secondary-container); border-left: 1px solid var(--md-sys-color-outline); border-right: 1px solid var(--md-sys-color-outline);">Orta</button>
                    <button style="padding:8px 16px; background: var(--md-sys-color-surface-variant); border:none; color: var(--md-sys-color-on-surface-variant);">Sağ</button>
                  </div>`
  },
  {
    name: "Sliders (Kaydırıcılar)",
    description: "Kullanıcıların bir değer aralığından seçim yapmasını sağlar.",
    m3Link: "https://m3.material.io/components/sliders/overview",
    types: ["Continuous Slider", "Discrete Slider", "Range Slider"],
    exampleHtml: `<div style="margin-bottom:20px;"><label for="slider1">Sürekli:</label> <md-slider id="slider1" min="0" max="100" value="50" aria-label="Ses Seviyesi"></md-slider></div>
                  <div><label for="slider2">Aralıklı (Ticks):</label> <md-slider id="slider2" min="0" max="100" value="30" step="10" ticks labeled aria-label="Aralık Kaydırıcı"></md-slider></div>
                  <p><i>Range slider için <code><md-slider range value-start="20" value-end="70"></md-slider></code> gibi bir kullanım olabilir.</i></p>`
  },
  {
    name: "Snackbars",
    description: "Ekranın altında kısa mesajlar gösterir. Genellikle bir eylemin sonucu hakkında geri bildirim sağlar.",
    m3Link: "https://m3.material.io/components/snackbar/overview",
    exampleHtml: `<p><i>MWC'de <code style='font-family:monospace'><md-snackbar></code> bileşeni mevcuttur. Genellikle JavaScript ile tetiklenir.</i></p>
                  <md-filled-button id="show-snackbar-btn">Snackbar Göster</md-filled-button>
                  <md-snackbar id="example-snackbar" label-text="Bu bir bildirim mesajıdır.">
                    <md-text-button slot="action">Kapat</md-text-button>
                  </md-snackbar>`
  },
  {
    name: "Tabs (Sekmeler)",
    description: "İçeriği farklı görünümler, ekranlar veya modlar arasında düzenler ve gezinmeyi sağlar.",
    m3Link: "https://m3.material.io/components/tabs/overview",
    types: ["Primary Tabs", "Secondary Tabs"],
    exampleHtml: `<md-tabs aria-label="Örnek Sekmeler">
                    <md-primary-tab aria-label="Sekme 1">Sekme 1</md-primary-tab>
                    <md-primary-tab aria-label="Sekme 2" active>Sekme 2 <md-icon slot="icon">pets</md-icon></md-primary-tab>
                    <md-primary-tab aria-label="Sekme 3">Sekme 3</md-primary-tab>
                  </md-tabs>`
  },
  {
    name: "Time Pickers (Zaman Seçiciler)",
    description: "Kullanıcıların bir zaman seçmesini sağlar.",
    m3Link: "https://m3.material.io/components/time-pickers/overview",
    types: ["Time Input", "Time Picker Dial"],
    exampleHtml: `<p><i>MWC'de <code style='font-family:monospace'><md-time-picker></code> bileşeni henüz tam olarak mevcut değildir veya deneysel aşamadadır.</i></p>`
  },
  {
    name: "Tooltips (Araç İpuçları)",
    description: "Bir öğenin üzerine gelindiğinde, odaklanıldığında veya uzun basıldığında bilgilendirici metin gösterir.",
    m3Link: "https://m3.material.io/components/tooltips/overview",
    types: ["Plain Tooltip", "Rich Tooltip"],
    exampleHtml: `<md-filled-button id="tooltip-anchor-btn">Üzerime Gel</md-filled-button>
                  <md-tooltip anchor="tooltip-anchor-btn">Bu bir araç ipucudur!</md-tooltip>
                  <p><i>Not: MWC'de <code style='font-family:monospace'><md-tooltip></code> henüz tam stabil olmayabilir veya kullanımı farklılık gösterebilir.</i></p>`
  }
];

const pageTitle = "Yeni Material 3 Bileşenleri (M3 Expressive Update)";

// Icon styles are now managed in public/fonts/material-symbols.css
---

<!-- Icon styles are now managed in public/fonts/material-symbols.css -->

<!-- Icon management is now handled by the centralized styles -->

<div class="container mx-auto p-4">
  <h1 class="text-3xl font-bold mb-6">{pageTitle}</h1>
  
  {newComponents.map((component, index) => (
    <div class="mb-8 p-6 bg-surface-container-high rounded-xl elevation-1">
      <h2 class="text-2xl font-semibold mb-2 text-on-surface">{component.name}</h2>
      <p class="text-on-surface-variant mb-4">{component.description}</p>
      
      <div class="my-4 p-4 bg-surface-container rounded-lg">
        <div class="space-y-4" set:html={component.exampleHtml || `<p class="text-on-surface-variant"><i>Bu bileşen için MWC örneği henüz eklenmedi.</i></p>`} />
      </div>
      
      <a 
        href={component.m3Link} 
        target="_blank" 
        class="text-primary hover:underline inline-flex items-center gap-1"
      >
        Material 3 Dokümantasyonu <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>
  ))}
</div>

<!-- Material Icons are now loaded from public/fonts/material-symbols.css -->

<!-- Stil düzeltmeleri -->
<style>
  /* Web Component'lerin düzgün görüntülenmesi için */
  md-outlined-text-field,
  md-filled-button,
  md-outlined-button,
  md-icon-button,
  md-switch,
  md-chip-set,
  md-chip,
  md-tabs,
  md-dialog,
  md-snackbar {
    margin: 0.5rem 0;
    --md-sys-color-primary: var(--primary-500);
    --md-sys-color-on-primary: var(--primary-50);
    --md-sys-color-primary-container: var(--primary-100);
    --md-sys-color-on-primary-container: var(--primary-900);
    --md-sys-color-secondary: var(--secondary-500);
    --md-sys-color-on-secondary: var(--secondary-50);
    --md-sys-color-secondary-container: var(--secondary-100);
    --md-sys-color-on-secondary-container: var(--secondary-900);
    --md-sys-color-surface: var(--md-sys-color-surface, #fffbfe);
    --md-sys-color-on-surface: var(--md-sys-color-on-surface, #1c1b1f);
    --md-sys-color-surface-variant: var(--md-sys-color-surface-variant, #e7e0ec);
    --md-sys-color-on-surface-variant: var(--md-sys-color-on-surface-variant, #49454f);
  }
  
  /* Yükleme animasyonu */
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  /* Bileşenler yüklenirken görünecek stil */
  .loading-placeholder {
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    font-style: italic;
    animation: fadeIn 0.3s ease-in;
  }
</style>

<script>
  // ... existing script code ...
</script>