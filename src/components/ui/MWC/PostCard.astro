---
interface Props {
  title: string;
  summary: string;
  date: string;
  slug: string;
  image?: string;
}

const { title, summary, date, slug, image } = Astro.props;
---

<a href={`/blog/${slug}`} class="m3-post-card">
  {image && (
    <div class="m3-post-card-image">
      <img src={image} alt={title} loading="lazy" />
    </div>
  )}
  <div class="m3-post-card-content">
    <h3 class="m3-post-card-title">{title}</h3>
    <p class="m3-post-card-summary">{summary}</p>
    <span class="m3-post-card-date">{new Date(date).toLocaleDateString('tr-TR', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })}</span>
  </div>
</a>

<style>
  .m3-post-card {
    display: block;
    background: var(--md-sys-color-surface-container);
    border-radius: 28px;
    overflow: hidden;
    transition: transform 0.2s var(--md-sys-motion-easing-emphasized),
                box-shadow 0.2s var(--md-sys-motion-easing-emphasized);
    text-decoration: none;
    height: 100%;
    box-shadow: var(--md-sys-elevation-level1);
  }

  .m3-post-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--md-sys-elevation-level2);
  }

  .m3-post-card-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    position: relative;
  }

  .m3-post-card-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent, var(--md-sys-color-surface-container));
    opacity: 0.3;
  }

  .m3-post-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s var(--md-sys-motion-easing-emphasized);
  }

  .m3-post-card:hover .m3-post-card-image img {
    transform: scale(1.05);
  }

  .m3-post-card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .m3-post-card-title {
    color: var(--md-sys-color-on-surface);
    font-size: 1.25rem;
    font-weight: 500;
    margin: 0;
    line-height: 1.4;
  }

  .m3-post-card-summary {
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.875rem;
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .m3-post-card-date {
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.75rem;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .m3-post-card {
      border-radius: 24px;
    }
    
    .m3-post-card-content {
      padding: 1.25rem;
    }
  }
</style> 