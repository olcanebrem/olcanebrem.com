---
// Astro bileşeni içinde
const { siteTitle = "OLCAN" } = Astro.props;
import HeaderMenuCustom from "@/components/HeaderMenuCustom";
import SignButton from "@/components/SignButton.astro";
import Sidebar from "@/components/Sidebar.astro";
import ThemeToggler from "@/components/ThemeToggler";
---

<script>
  let isScrolled = false;

  if (typeof window !== 'undefined') {
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      const header = document.querySelector('#site-header');
      const inner = document.querySelector('.header-inner');

      if (scrollY > 10 && !isScrolled) {
        header?.classList.add('scrolled');
        inner?.classList.add('scrolled');
        isScrolled = true;
      } else if (scrollY <= 10 && isScrolled) {
        header?.classList.remove('scrolled');
        inner?.classList.remove('scrolled');
        isScrolled = false;
      }
    });
  }
</script>

<header id="site-header" class="site-header">
  <div class="header-inner">
    <Sidebar />
    <button 
      id="openSidebar"
      class="m3-icon-button"
      aria-label="Open navigation drawer"
      onclick="toggleSidebar()"
    >
      <span class="material-symbols-rounded">menu</span>
      <div class="m3-state-layer" />
    </button>
    <a href="/" class="site-title">{siteTitle}</a>
    <div class="header-menu">
      <HeaderMenuCustom client:load />
    </div>
    <div class="header-actions">
      <div class="action-items">
        <div class="sign-button-container">
          <SignButton />
        </div>
        <ThemeToggler client:load />
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* Header Styles */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50;
    transition: all 300ms ease-in-out;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
  }

  .site-header.scrolled {
    top: 10px;
  }

  .header-inner {
    background-color: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface-container);
    box-shadow: var(--md-sys-elevation-level1);
    transition: all 300ms ease;
    margin: 0 auto;
    max-width: 100%;
    padding: 0.5rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    border-radius: 0;
    height: 4rem; /* Sabit yükseklik */
  }

  .header-inner.scrolled {
    max-width: 880px;
    border-radius: 2rem;
    background-color: var(--md-sys-color-surface-container-high);
  }

  .site-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
    position: relative;
    z-index: 10;
  }

  .header-menu {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
    justify-content: center;
  }

  .header-actions {
    display: flex;
    align-items: center;
    position: relative;
    height: 100%; /* Header yüksekliğine eşit */
  }

  .action-items {
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
    height: 100%; /* Header yüksekliğine eşit */
  }

  .sign-button-container {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }

  /* Icon Button Styles */
  .m3-icon-button {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    color: var(--md-sys-color-on-surface-variant);
    overflow: hidden;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .m3-icon-button:hover .m3-state-layer {
    background-color: var(--md-sys-color-on-surface-variant);
    opacity: 0.08;
  }

  .m3-icon-button:active .m3-state-layer {
    background-color: var(--md-sys-color-on-surface-variant);
    opacity: 0.12;
  }

  .m3-state-layer {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    transition: background-color 0.2s ease;
  }

  @media (max-width: 768px) {
    .header-inner {
      padding: 0.5rem 1rem;
    }
    
    .header-menu {
      display: none;
    }

    .action-items {
      gap: 0.5rem;
    }
  }
</style>
