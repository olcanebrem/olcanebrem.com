---
// Astro bileşeni içinde
const { siteTitle = "OLCAN" } = Astro.props;
import HeaderMenuCustom from "@/components/HeaderMenuCustom";
import SignButton from "@/components/SignButton.tsx";
import Sidebar from "@/components/Sidebar.astro";
import ThemeToggler from "@/components/ThemeToggler";
---

<script>
  let isScrolled = false;

  // Script kısmında:
if (typeof window !== 'undefined') {
  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    const header = document.querySelector('#site-header');
    const inner = document.querySelector('.header-inner');

    if (scrollY > 10 && !isScrolled) {
      header?.classList.add('scrolled');
      inner?.classList.add('scrolled');
      isScrolled = true;
    } else if (scrollY <= 10 && isScrolled) {
      header?.classList.remove('scrolled');
      inner?.classList.remove('scrolled');
      isScrolled = false;
    }
  });
}

</script>

<header id="site-header"
  class="fixed left-0 w-full z-50 transition-all duration-300 ease-in-out"
>
  <div
    class="header-inner mx-auto max-w-full transition-[border-radius,max-width] duration-700 ease-[cubic-bezier(.4,0,.2,1)] rounded-none shadow-md p-2 px-8 flex items-center justify-between relative scrolled:rounded-2xl"
  > <Sidebar />
    <button 
      id="openSidebar"
      class="m3-icon-button"
      aria-label="Open navigation drawer"
      onclick="toggleSidebar()"
    >
      <span class="material-symbols-rounded">menu</span>
      <div class="m3-state-layer" />
    </button>
    <a href="/" class="text-xl font-bold relative z-10 text-on-surface">{siteTitle}</a>
    <div class="flex items-center gap-4">
      <HeaderMenuCustom client:load />
    </div>
    <div class="flex items-center space-x-2">
      <SignButton client:load />
      <ThemeToggler client:load />
    </div>
  </div>
</header>


<style>
/* CSS içinde */
header {
  top: 0;
}
header.scrolled {
  top: 10px;
}
.header-inner {
  background-color: var(--md-sys-header-bg);
  color: var(--md-sys-header-fg);
  box-shadow: var(--md-sys-header-shadow);
  transition: all 300ms ease;
}

.header-inner.scrolled {
  max-width: 880px;
  border-radius: 2rem;
}

.m3-icon-button {
  position: relative;
  display: grid;
  place-items: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  color: var(--md-sys-color-on-surface-variant);
  overflow: hidden;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
}

.m3-icon-button:hover .m3-state-layer {
  background-color: var(--md-sys-color-on-surface-variant);
  opacity: 0.08;
}

.m3-icon-button:active .m3-state-layer {
  background-color: var(--md-sys-color-on-surface-variant);
  opacity: 0.12;
}

.m3-state-layer {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  transition: background-color 0.2s ease;
}

.material-symbols-rounded {
  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  font-size: 24px;
  line-height: 1;
}
</style>
