---
const { siteTitle = "CYBER_OPS" } = Astro.props;
---

<script>
  let isScrolled = false;

  if (typeof window !== 'undefined') {
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      const header = document.querySelector('#site-header');

      if (scrollY > 10 && !isScrolled) {
        header?.classList.add('scrolled');
        isScrolled = true;
      } else if (scrollY <= 10 && isScrolled) {
        header?.classList.remove('scrolled');
        isScrolled = false;
      }
    });
  }
</script>

<header id="site-header" class="site-header cyber-header">
  <div class="header-border"></div>
  <div class="header-inner">
    <div class="header-left">
      <a href="/" class="site-title">
        <span class="title-bracket">[</span>
        <span class="title-text">{siteTitle}</span>
        <span class="title-bracket">]</span>
      </a>
      <div class="status-indicator">
        <span class="status-dot"></span>
        <span class="status-text">ONLINE</span>
      </div>
    </div>
    <nav class="header-menu">
      <div class="menu-item-wrapper">
        <button class="menu-item has-popover" id="products-menu">
          <span class="menu-icon">▸</span>
          <span>PRODUCTS</span>
          <span class="dropdown-arrow">▼</span>
        </button>
        <div class="popover" id="products-popover">
          <div class="popover-content">
            <a href="#studio" class="popover-item">
              <span class="popover-icon">◆</span>
              <div class="popover-text">
                <span class="popover-title">STUDIO</span>
                <span class="popover-desc">Content management interface</span>
              </div>
            </a>
            <a href="#api" class="popover-item">
              <span class="popover-icon">◆</span>
              <div class="popover-text">
                <span class="popover-title">API</span>
                <span class="popover-desc">Real-time content API</span>
              </div>
            </a>
            <a href="#cdn" class="popover-item">
              <span class="popover-icon">◆</span>
              <div class="popover-text">
                <span class="popover-title">CDN</span>
                <span class="popover-desc">Global content delivery</span>
              </div>
            </a>
          </div>
        </div>
      </div>

      <div class="menu-item-wrapper">
        <button class="menu-item has-popover" id="resources-menu">
          <span class="menu-icon">▸</span>
          <span>RESOURCES</span>
          <span class="dropdown-arrow">▼</span>
        </button>
        <div class="popover" id="resources-popover">
          <div class="popover-content">
            <a href="#docs" class="popover-item">
              <span class="popover-icon">◆</span>
              <div class="popover-text">
                <span class="popover-title">DOCS</span>
                <span class="popover-desc">Documentation & guides</span>
              </div>
            </a>
            <a href="#templates" class="popover-item">
              <span class="popover-icon">◆</span>
              <div class="popover-text">
                <span class="popover-title">TEMPLATES</span>
                <span class="popover-desc">Pre-built solutions</span>
              </div>
            </a>
            <a href="#community" class="popover-item">
              <span class="popover-icon">◆</span>
              <div class="popover-text">
                <span class="popover-title">COMMUNITY</span>
                <span class="popover-desc">Join the network</span>
              </div>
            </a>
          </div>
        </div>
      </div>

      <a href="#data" class="menu-item">
        <span class="menu-icon">▸</span>
        <span>PRICING</span>
      </a>
    </nav>
    <div class="header-actions">
      <div class="system-time" id="system-time"></div>
    </div>
  </div>
</header>

<script>
  // Update system time
  function updateTime() {
    const timeEl = document.getElementById('system-time');
    if (timeEl) {
      const now = new Date();
      const hours = String(now.getHours()).padStart(2, '0');
      const minutes = String(now.getMinutes()).padStart(2, '0');
      const seconds = String(now.getSeconds()).padStart(2, '0');
      timeEl.textContent = `${hours}:${minutes}:${seconds}`;
    }
  }

  if (typeof window !== 'undefined') {
    updateTime();
    setInterval(updateTime, 1000);
  }

  // Popover functionality
  if (typeof window !== 'undefined') {
    window.addEventListener('load', () => {
      const productsMenu = document.getElementById('products-menu');
      const productsPopover = document.getElementById('products-popover');
      const resourcesMenu = document.getElementById('resources-menu');
      const resourcesPopover = document.getElementById('resources-popover');

      let activePopover = null;

      function showPopover(popover) {
        if (activePopover && activePopover !== popover) {
          activePopover.classList.remove('active');
        }
        if (popover) {
          popover.classList.add('active');
          activePopover = popover;
        }
      }

      function hidePopover(popover) {
        if (popover) {
          popover.classList.remove('active');
          if (activePopover === popover) {
            activePopover = null;
          }
        }
      }

      if (productsMenu && productsPopover) {
        const productsWrapper = productsMenu.parentElement;
        if (productsWrapper) {
          let hideTimeout;

          const showProducts = () => {
            clearTimeout(hideTimeout);
            showPopover(productsPopover);
          };

          const hideProducts = () => {
            hideTimeout = setTimeout(() => {
              hidePopover(productsPopover);
            }, 100);
          };

          productsWrapper.addEventListener('mouseenter', showProducts);
          productsWrapper.addEventListener('mouseleave', hideProducts);
          productsPopover.addEventListener('mouseenter', showProducts);
          productsPopover.addEventListener('mouseleave', hideProducts);
        }
      }

      if (resourcesMenu && resourcesPopover) {
        const resourcesWrapper = resourcesMenu.parentElement;
        if (resourcesWrapper) {
          let hideTimeout;

          const showResources = () => {
            clearTimeout(hideTimeout);
            showPopover(resourcesPopover);
          };

          const hideResources = () => {
            hideTimeout = setTimeout(() => {
              hidePopover(resourcesPopover);
            }, 100);
          };

          resourcesWrapper.addEventListener('mouseenter', showResources);
          resourcesWrapper.addEventListener('mouseleave', hideResources);
          resourcesPopover.addEventListener('mouseenter', showResources);
          resourcesPopover.addEventListener('mouseleave', hideResources);
        }
      }

      // Close popover when clicking outside
      document.addEventListener('click', (e) => {
        if (activePopover && !e.target.closest('.menu-item-wrapper')) {
          hidePopover(activePopover);
        }
      });
    });
  }
</script>

<style>
  /* Cyber Header Variables */
  .cyber-header {
    --cyber-black: #000000;
    --cyber-dark: #0a0a0a;
    --cyber-border: #333333;
    --cyber-accent: #00ff88;
    --cyber-accent-dim: #00ff8844;
    --cyber-blue: #00d9ff;
    --cyber-white: #ffffff;
    --cyber-text: #e0e0e0;
    --cyber-text-dim: #888888;
  }

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--cyber-border);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .site-header.scrolled {
    background: rgba(0, 0, 0, 0.95);
    border-bottom-color: var(--cyber-accent);
    box-shadow: 0 0 20px rgba(0, 255, 136, 0.2);
  }

  .header-border {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cyber-accent), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .site-header.scrolled .header-border {
    opacity: 0.5;
  }

  .header-inner {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 2rem;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .site-title {
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--cyber-white);
    text-decoration: none;
    letter-spacing: 0.1em;
    font-family: 'Courier New', monospace;
    transition: color 0.3s ease;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .title-bracket {
    color: var(--cyber-accent);
  }

  .title-text {
    color: var(--cyber-white);
  }

  .site-title:hover .title-text {
    color: var(--cyber-accent);
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--cyber-border);
    background: rgba(0, 255, 136, 0.05);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    font-family: 'Courier New', monospace;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--cyber-accent);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--cyber-accent);
  }

  .status-text {
    color: var(--cyber-accent);
  }

  .header-menu {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .menu-item-wrapper {
    position: relative;
  }

  .menu-item {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--cyber-text-dim);
    text-decoration: none;
    transition: color 0.3s ease;
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    letter-spacing: 0.15em;
    font-family: 'Courier New', monospace;
    padding: 0.5rem 0;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .menu-icon {
    opacity: 0;
    transform: translateX(-5px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    color: var(--cyber-accent);
  }

  .dropdown-arrow {
    font-size: 0.5rem;
    margin-left: 0.25rem;
    transition: transform 0.3s ease;
  }

  .menu-item:hover .dropdown-arrow {
    transform: translateY(2px);
  }

  .menu-item:hover {
    color: var(--cyber-accent);
  }

  .menu-item:hover .menu-icon {
    opacity: 1;
    transform: translateX(0);
  }

  .menu-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--cyber-accent);
    box-shadow: 0 0 5px var(--cyber-accent);
    transition: width 0.3s ease;
  }

  .menu-item:hover::after {
    width: 100%;
  }

  /* Popover Styles */
  .popover {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 1rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
    z-index: 10000;
    pointer-events: none;
  }

  .popover.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .popover-content {
    background: rgba(0, 0, 0, 0.95);
    border: 1px solid var(--cyber-accent);
    box-shadow: 0 0 20px rgba(0, 255, 136, 0.3);
    padding: 1rem;
    min-width: 280px;
    backdrop-filter: blur(10px);
  }

  .popover-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.75rem;
    text-decoration: none;
    border: 1px solid transparent;
    transition: all 0.3s ease;
    margin-bottom: 0.5rem;
  }

  .popover-item:last-child {
    margin-bottom: 0;
  }

  .popover-item:hover {
    border-color: var(--cyber-accent);
    background: rgba(0, 255, 136, 0.05);
  }

  .popover-icon {
    color: var(--cyber-accent);
    font-size: 0.75rem;
    margin-top: 0.25rem;
  }

  .popover-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .popover-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--cyber-white);
    letter-spacing: 0.1em;
    font-family: 'Courier New', monospace;
  }

  .popover-desc {
    font-size: 0.65rem;
    color: var(--cyber-text-dim);
    font-family: 'Courier New', monospace;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .system-time {
    font-family: 'Courier New', monospace;
    font-size: 0.875rem;
    color: var(--cyber-text);
    padding: 0.5rem 1rem;
    border: 1px solid var(--cyber-border);
    background: rgba(26, 26, 26, 0.5);
    letter-spacing: 0.1em;
    min-width: 90px;
    text-align: center;
  }

  @media (max-width: 968px) {
    .header-menu {
      display: none;
    }

    .status-indicator {
      display: none;
    }

    .header-inner {
      padding: 0 1rem;
    }
  }

  @media (max-width: 480px) {
    .system-time {
      font-size: 0.75rem;
      padding: 0.4rem 0.75rem;
      min-width: 80px;
    }

    .site-title {
      font-size: 1rem;
    }
  }
</style>
