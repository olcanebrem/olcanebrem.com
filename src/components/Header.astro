---
// Astro bileşeni içinde
const { siteTitle = "OLCAN" } = Astro.props;
import HeaderMenuCustom from "@/components/HeaderMenuCustom";
import ThemeDropdown from "@/components/ThemeDropdown";
import SignButton from "@/components/SignButton.tsx";
import Sidebar from "@/components/Sidebar.astro";
---

<script>
  let isScrolled = false;

  // Script kısmında:
if (typeof window !== 'undefined') {
  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    const header = document.querySelector('#site-header');
    const inner = document.querySelector('.header-inner');

    if (scrollY > 10 && !isScrolled) {
      header?.classList.add('scrolled');
      inner?.classList.add('scrolled');
      isScrolled = true;
    } else if (scrollY <= 10 && isScrolled) {
      header?.classList.remove('scrolled');
      inner?.classList.remove('scrolled');
      isScrolled = false;
    }
  });
}

</script>

<header id="site-header"
  class="fixed left-0 w-full z-50 transition-all duration-300 ease-in-out"
>
  <div
    class="header-inner mx-auto max-w-full transition-[border-radius,max-width] duration-700 ease-[cubic-bezier(.4,0,.2,1)] rounded-none shadow-md p-2 px-8 flex items-center justify-between relative scrolled:rounded-2xl"
  >
  <Sidebar />
    <a href="/" class="text-xl font-bold relative z-10 text-on-surface">{siteTitle}</a>
    <HeaderMenuCustom client:load />
    <div class="flex items-center space-x-2">
      <SignButton client:load />
      <ThemeDropdown client:load />
    </div>
  </div>
</header>


<style>
/* CSS içinde */
header {
  top: 0;
}
header.scrolled {
  top: 10px;
}
.header-inner {
  background-color: var(--md-sys-header-bg);
  color: var(--md-sys-header-fg);
  box-shadow: var(--md-sys-header-shadow);
  transition: all 300ms ease;
}

.header-inner.scrolled {
  max-width: 880px;
  border-radius: 2rem;
}

</style>
