---
const currentYear = new Date().getFullYear();
---

<section class="coming-soon-section">
  <div class="coming-soon-container">
    <div class="coming-soon-content">
      <h2 class="coming-soon-title">
        Get Ready for Something Amazing!
      </h2>
      <p class="coming-soon-description">
        We're excited to introduce our latest innovation that will
        change the way you develop. Stay tuned as we put the finishing
        touches on this game-changing product.
      </p>
      <p class="coming-soon-subtitle">
        Sign up now to be the first to know when we launch
      </p>
      <div class="coming-soon-form">
        <input
          type="email"
          placeholder="Your Email"
          class="coming-soon-input"
        />
        <button class="coming-soon-button">
          notify me
        </button>
      </div>
    </div>
    <p class="coming-soon-footer">
      All rights reserved. Copyright &copy; {currentYear} Olcan Ebrem
    </p>
  </div>
</section>

<style>
  .coming-soon-section {
    display: grid;
    min-height: 100vh;
    width: 100%;
    background: var(--md-sys-color-surface);
  }

  .coming-soon-container {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
    text-align: center;
  }

  .coming-soon-content {
    margin: auto 0;
    text-align: center;
  }

  .coming-soon-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    color: var(--md-sys-color-on-surface);
    margin: 0 0 1rem 0;
  }

  .coming-soon-description {
    margin: 1rem auto 2.5rem;
    color: var(--md-sys-color-on-surface-variant);
    width: 100%;
    max-width: 48rem;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .coming-soon-subtitle {
    font-weight: 500;
    color: var(--md-sys-color-on-surface-variant);
    margin-bottom: 1.5rem;
  }

  .coming-soon-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    max-width: 28rem;
    margin: 0 auto;
  }

  .coming-soon-input {
    width: 100%;
    padding: 1rem 1.5rem;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: 2rem;
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface);
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .coming-soon-input:focus {
    outline: none;
    border-color: var(--md-sys-color-primary);
    box-shadow: 0 0 0 2px var(--md-sys-color-primary-container);
  }

  .coming-soon-button {
    width: 100%;
    padding: 1rem 2rem;
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    border: none;
    border-radius: 2rem;
    font-size: 1rem;
    font-weight: 500;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .coming-soon-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .coming-soon-footer {
    margin-top: auto;
    margin-bottom: 5rem;
    font-weight: 500;
    color: var(--md-sys-color-on-surface-variant);
  }

  @media (min-width: 768px) {
    .coming-soon-form {
      flex-direction: row;
    }

    .coming-soon-button {
      width: auto;
      max-width: fit-content;
    }
  }
</style>
