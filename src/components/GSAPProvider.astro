---
// GSAPProvider.astro
---

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ScrollSmoother } from 'gsap/ScrollSmoother'; // Bu import önemli

  let smootherInstance = null;
  let footerScrollTrigger = null;

  function setupGsapAnimations() {
    console.log('GSAPProvider: setupGsapAnimations CALLED');

    // Plugin'i burada, her kurulum denemesinde kaydet
    // Bu, plugin'in kapsamıyla ilgili olası sorunları çözebilir
    gsap.registerPlugin(ScrollTrigger, ScrollSmoother);
    console.log('GSAPProvider: ScrollTrigger and ScrollSmoother registered (or re-registered).');

    if (smootherInstance) {
      console.log('GSAPProvider: Killing existing ScrollSmoother');
      smootherInstance.kill();
      smootherInstance = null;
    }
    if (footerScrollTrigger) {
      console.log('GSAPProvider: Killing existing footer ScrollTrigger');
      footerScrollTrigger.kill();
      footerScrollTrigger = null;
    }

    requestAnimationFrame(() => {
      const wrapperEl = document.getElementById("smooth-wrapper");
      const contentEl = document.getElementById("smooth-content");
      const footerEl = document.querySelector(".footer");

      if (!wrapperEl || !contentEl) {
        console.warn('GSAPProvider: #smooth-wrapper veya #smooth-content bulunamadı. ScrollSmoother başlatılamadı.');
        return;
      }

      console.log('GSAPProvider: Initializing ScrollSmoother...');
      try {
        smootherInstance = ScrollSmoother.create({
          wrapper: wrapperEl,
          content: contentEl,
          smooth: 0.2,
          effects: true,
          smoothTouch: 0.05,
        });
        console.log('GSAPProvider: ScrollSmoother initialized successfully.');
      } catch (error) {
        console.error('GSAPProvider: ScrollSmoother.create FAILED:', error);
        // Eğer hata devam ederse, GSAP context'i ile ilgili olabilir
        // Özellikle Astro + View Transitions + GSAP kombinasyonunda
        // let ctx = gsap.context(() => { /* GSAP KODU BURAYA */ }, scope); // şeklinde bir kullanım gerekebilir
        // Ama önce plugin kaydını çözelim.
        return; // ScrollSmoother başlatılamadıysa devam etme
      }


      if (footerEl && smootherInstance) { // smootherInstance da olmalı
        console.log('GSAPProvider: Initializing footer ScrollTrigger...');
        footerScrollTrigger = ScrollTrigger.create({
          trigger: footerEl,
          pin: true,
          start: "bottom bottom",
          end: "95%",
          scroller: wrapperEl, // ScrollSmoother kullanılıyorsa scroller wrapper olmalı
          onEnter: () => {
            console.log('GSAPProvider: Footer onEnter');
            footerEl.classList.add('revealed');
          },
          onLeaveBack: () => {
            console.log('GSAPProvider: Footer onLeaveBack');
            footerEl.classList.remove('revealed');
          }
        });
        console.log('GSAPProvider: Footer ScrollTrigger initialized.');
      } else if (!footerEl) {
        console.warn('GSAPProvider: .footer bulunamadı.');
      } else if (!smootherInstance) {
        console.warn('GSAPProvider: ScrollSmoother başlatılamadığı için footer trigger kurulmadı.');
      }
      console.log('GSAPProvider: GSAP setup complete.');
    });
  }

  document.addEventListener('astro:page-load', setupGsapAnimations);
</script>


<style>
  .footer {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .footer.revealed {
    opacity: 1;
    transform: translateY(0);
  }
</style>