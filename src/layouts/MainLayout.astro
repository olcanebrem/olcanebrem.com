---
import "@styles/globals.css"
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MantineClientProvider from '@/components/providers/MantineClientProvider';
import { ViewTransitions } from 'astro:transitions';
import MwcLoader from '@/components/ui/MWC/MwcLoader';

---
<!DOCTYPE html>
<html lang="tr">
  <head>
    <MwcLoader />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Olcan Ebrem Portfolio</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Olcan Ebrem'in kişisel portfolyo sitesi" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <!-- Google Fonts (Roboto) ekleyebilirsiniz -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <script is:inline>
      const storedTheme = localStorage.getItem('theme') || 'theme-light';
      document.documentElement.className = ''; // Önceki tüm sınıfları temizle
      document.documentElement.classList.add(storedTheme);

      window.setTheme = function (theme) {
        const oldTheme = localStorage.getItem('theme') || 'theme-light';
        document.documentElement.classList.remove(oldTheme);
        document.documentElement.classList.add(theme);
        localStorage.setItem('theme', theme);
      };
    </script>

    <slot name="head" />
    <ViewTransitions />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-on-background">
    <MantineClientProvider client:load>
      {/* HATALI div yapısı düzeltildi. Eğer gradient bir arka plan isteniyorsa, bu CSS ile yapılmalı */}
      <div class="min-h-screen flex flex-col" style="background: linear-gradient(to bottom, var(--md-sys-color-surface, #FEF7FF) 0%, var(--md-sys-color-surface-variant, #E7E0EC) 100%);">
        
        <Header />
        {/* Sidebar toggle butonu muhtemelen Sidebar bileşeninin içinde veya Header'da olmalı */}
        {/* Eğer burada kalacaksa, MWC icon button kullanılabilir */}
        <button onclick="window.toggleSidebar()" class="fixed left-4 top-2 z-50 p-2 rounded-full hover:bg-surface-variant focus:outline-none" aria-label="Toggle navigation drawer">
         <md-icon-button id="menu-button">
          <span class="material-symbols-outlined">menu</span> {/* Google Material Symbols kullanıyorsanız, bunun için CSS/font linki de gerekir */}
        </md-icon-button>
        </button>
        <main class="flex-1 p-4 md:p-6" transition:animate="slide"> {/* Biraz padding ekledim */}
          <slot />
        </main>
        <Footer />
      </div>
    </MantineClientProvider>
  </body>
</html>
