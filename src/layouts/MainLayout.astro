---
// src/layouts/BaseLayout.astro
import "@/styles/globals.css";
import Header from '@/components/Header.astro';
import FooterContent from '@/components/Footer.astro';
import GSAPProvider from "@/components/GSAPProvider.astro";
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Olcane Brem', description = 'Kişisel Web Sitem' } = Astro.props;
---
<!DOCTYPE html>
<html lang="tr" class="scroll-smooth">
  <head>
    <!-- Loading Bar Styles - En üstte yüklenmesi için -->
    <style is:global>
      #top-loading-bar {
        position: fixed;
        top: 0; /* Navbar'ın üstünde olacak şekilde değiştirildi */
        left: 0;
        width: 100%;
        height: 3px; /* Daha ince bir loading bar */
        background: transparent; /* Arka plan rengini kaldırdık */
        z-index: 999999;
        pointer-events: none;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease, visibility 0s linear 0.2s;
      }
      
      #top-loading-bar.loading-active {
        opacity: 1;
        visibility: visible;
        transition: opacity 0.1s ease, visibility 0s linear;
      }
      
      #top-loading-bar .loading-bar-progress {
        width: 100%;
        height: 100%;
        background: var(--md-sys-color-primary);
        transform: translateX(-100%);
        transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 0 8px var(--md-sys-color-primary);
      }
    </style>

    <!-- Loading Bar HTML -->
    <div id="top-loading-bar">
      <div class="loading-bar-progress"></div>
    </div>

    <!-- Loading Bar Script -->
    <script is:inline>
      (function() {
        const loadingBar = document.getElementById('top-loading-bar');
        const progressBar = loadingBar?.querySelector('.loading-bar-progress');
      
        if (!loadingBar || !progressBar) {
          console.warn('Loading bar elementi bulunamadı.');
          return;
        }
      
        let progressInterval = null;
        let currentProgress = 0;
        let isPageFullyLoaded = false;
        const MAX_PROGRESS = 90;
        const INTERVAL = 30;
      
        function setProgress(percentage) {
          currentProgress = Math.min(percentage, 100);
          progressBar.style.transform = `translateX(${currentProgress - 100}%)`;
        }
      
        function startLoading() {
          if (progressInterval) clearInterval(progressInterval);
          isPageFullyLoaded = false;
          setProgress(0);
          loadingBar.classList.add('loading-active');
      
          let startTime = Date.now();
          const duration = 2000;
      
          progressInterval = setInterval(() => {
            const elapsed = Date.now() - startTime;
            const progress = Math.min((elapsed / duration) * MAX_PROGRESS, MAX_PROGRESS);
            
            // Easing fonksiyonu ile daha doğal bir ilerleme
            const easedProgress = progress * (2 - progress / MAX_PROGRESS);
            setProgress(easedProgress);
      
            if (progress >= MAX_PROGRESS && isPageFullyLoaded) {
              completeLoading();
            }
          }, INTERVAL);
        }
      
        function completeLoading() {
          if (progressInterval) {
            clearInterval(progressInterval);
            progressInterval = null;
          }
          setProgress(100);
      
          setTimeout(() => {
            loadingBar.classList.remove('loading-active');
            setTimeout(() => {
              if (!loadingBar.classList.contains('loading-active')) {
                setProgress(0);
              }
            }, 200);
          }, 100);
        }

        function checkPageLoad() {
          // Tüm resimlerin yüklenmesini bekle
          const images = Array.from(document.images);
          const pendingImages = images.filter(img => !img.complete);
          
          if (pendingImages.length === 0) {
            // Tüm scriptlerin yüklenmesini bekle
            const scripts = Array.from(document.scripts);
            const pendingScripts = scripts.filter(script => !script.complete && !script.defer);
            
            if (pendingScripts.length === 0) {
              isPageFullyLoaded = true;
              if (currentProgress >= MAX_PROGRESS) {
                completeLoading();
              }
            }
          }
        }
      
        // Sayfa geçişlerini dinle
        document.addEventListener('astro:before-preparation', startLoading);
        
        // Sayfa yüklendiğinde
        document.addEventListener('astro:page-load', () => {
          // Önce DOM'un hazır olmasını bekle
          requestAnimationFrame(() => {
            // Ardından tüm kaynakların yüklenmesini kontrol et
            if (document.readyState === 'complete') {
              checkPageLoad();
            } else {
              window.addEventListener('load', checkPageLoad);
            }
          });
        });

        // Resim yüklendiğinde kontrol et
        document.addEventListener('load', function(e) {
          if (e.target instanceof HTMLImageElement) {
            checkPageLoad();
          }
        }, true);

        document.addEventListener('astro:error', () => {
          isPageFullyLoaded = true;
          completeLoading();
        });
        
        // Link tıklamalarını dinle
        document.addEventListener('click', function(e) {
          const target = e.target;
          const link = target.closest('a');
          if (link && link.href && !link.target && !e.ctrlKey && !e.metaKey) {
            startLoading();
          }
        });

        // Sayfa geçişlerini yönet
        document.addEventListener('astro:before-preparation', function() {
          const contentWrapper = document.querySelector('.content-wrapper');
          if (contentWrapper instanceof HTMLElement) {
            // Geçiş başlamadan önce scroll pozisyonunu kaydet
            const scrollPosition = window.scrollY;
            contentWrapper.style.transform = `translateY(${-scrollPosition}px)`;
            contentWrapper.classList.add('page-transitioning');
          }
        });

        document.addEventListener('astro:after-swap', function() {
          const contentWrapper = document.querySelector('.content-wrapper');
          if (contentWrapper instanceof HTMLElement) {
            // Geçiş bittikten sonra scroll pozisyonunu geri yükle
            const scrollPosition = window.scrollY;
            contentWrapper.style.transition = 'none';
            contentWrapper.style.transform = 'none';
            contentWrapper.classList.remove('page-transitioning');
            window.scrollTo(0, scrollPosition);
            void contentWrapper.offsetHeight;
            contentWrapper.style.transition = '';
          }
        });

        // Sayfa ilk yüklendiğinde opacity'yi ayarla
        document.addEventListener('DOMContentLoaded', function() {
          const contentWrapper = document.querySelector('.content-wrapper');
          if (contentWrapper instanceof HTMLElement) {
            contentWrapper.style.opacity = '1';
          }
        });
      })();
    </script>

    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    
    <!-- Font Awesome - Local -->
    <link rel="stylesheet" href="/node_modules/@fortawesome/fontawesome-free/css/all.min.css" />

    <!-- Open Graph / Social Media Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content="/og-image.jpg" />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-image.jpg" />
    
    <!-- Tema yükleme scripti -->
    <script is:inline>
      // Sayfa yüklenmeden önce tema kontrolü yap
      (function() {
        // localStorage'dan temayı al veya sistem temasını kontrol et
        const savedTheme = localStorage.getItem('theme');
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = savedTheme || (systemDark ? 'theme-dark' : 'theme-light');
        
        // Temayı hemen uygula
        document.documentElement.className = theme;
        
        // Tema değişikliklerini dinle
        window.setTheme = function(newTheme) {
          document.documentElement.classList.remove('theme-light', 'theme-dark');
          document.documentElement.classList.add(newTheme);
          localStorage.setItem('theme', newTheme);
        };
      })();
    </script>

    <!-- Material Web Components -->
    <script type="module" src="https://esm.sh/@material/web/all.js"></script>
    
    <!-- Web Components Polyfill -->
    <script src="https://unpkg.com/@webcomponents/webcomponentsjs@2.8.0/webcomponents-bundle.js" nomodule></script>
    
    <!-- Tema ve stil tanımları -->
    <style>
      :not(:defined) > * {
        opacity: 0;
        transition: opacity 0.3s ease-in-out;
      }
    </style>
    
    <!-- Material Icons -->
    <link 
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" 
      rel="stylesheet"
    />
    
    <!-- View Transitions -->
    <ViewTransitions />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100">
    <Header transition:persist="none" />
    <GSAPProvider />
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <div class="main-content">
         <div class="content-wrapper">
              <main transition:persist-scroll>
                <slot />
              </main>
          </div>
        </div>
        <div class="footer">
          <FooterContent/>
        </div>
      </div>
    </div>
    
    <!-- Web Components yüklendikten sonra görünür yap -->
    <script>
      window.addEventListener('WebComponentsReady', () => {
        console.log('Web Components yüklendi');
        document.body.classList.add('web-components-loaded');
      });
      
      // Fallback: 3 saniye sonra bile yüklenmemişse göster
      setTimeout(() => {
        document.body.classList.add('web-components-loaded');
      }, 3000);
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Material Design 3 Color System (Mevcut) */
    --md-sys-color-background: var(--md-sys-color-surface);
    --md-sys-color-on-background: var(--md-sys-color-on-surface);
    
    /* Material Design 3 Shape System (Mevcut) */
    --md-sys-shape-corner-none: 0px;
    --md-sys-shape-corner-extra-small: 4px;
    --md-sys-shape-corner-small: 8px;
    --md-sys-shape-corner-medium: 12px;
    --md-sys-shape-corner-large: 16px;
    --md-sys-shape-corner-extra-large: 28px;
    --md-sys-shape-corner-full: 9999px;

    /* Scrollbar styles (Mevcut) */
    scrollbar-width: thin;
    scrollbar-color: var(--md-sys-color-outline) transparent;

    /* Grain Efekti Değişkenleri */
    --grain-tile-size: 400px; /* SVG'deki viewBox ile uyumlu veya isteğe bağlı */
    
    --grain-opacity-light: 0.6; /* Açık tema için ince bir opaklık */
    --grain-filter-light: contrast(170%) brightness(130%) saturate(0%); /* Monokrom ve ayarlanmış grain */
    
    --grain-opacity-dark: 0.2;  /* Koyu tema için daha da ince bir opaklık */
    --grain-filter-dark: contrast(160%) brightness(120%) saturate(0%); /* Monokrom ve ayarlanmış grain */

    /* Aktif tema için kullanılacak grain özellikleri */
    /* Varsayılan olarak açık tema değerlerini alır (JavaScript tema değiştiriciniz bunu güncelleyecek) */
    --current-grain-opacity: var(--grain-opacity-light);
    --current-grain-filter: var(--grain-filter-light);
  }

  /* Tema Değişikliğine Göre Grain Ayarları */
  /* BaseLayout.astro'daki tema scripti <html> etiketine .theme-light veya .theme-dark ekler */
  html.theme-light {
    --current-grain-opacity: var(--grain-opacity-light);
    --current-grain-filter: var(--grain-filter-light);
    /* İsterseniz burada açık tema için diğer :root değişkenlerini de override edebilirsiniz */
  }

  html.theme-dark {
    --current-grain-opacity: var(--grain-opacity-dark);
    --current-grain-filter: var(--grain-filter-dark);
    /* İsterseniz burada koyu tema için diğer :root değişkenlerini de override edebilirsiniz */
  }

  /* Webkit scrollbar styles (Mevcut) */
  ::-webkit-scrollbar {
    width: 8px;
    background-color: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background-color: var(--md-sys-color-outline);
    border-radius: 4px;
  }

  ::-webkit-scrollbar-track {
    background-color: transparent;
  }

  html { /* (Mevcut) */
    overflow-y: scroll;
    scrollbar-gutter: stable;
  }

  body { /* (Mevcut - font-size: 32px oldukça büyük, 16px veya 1rem daha yaygındır) */
    font-size: 16px; /* Daha standart bir temel font boyutu */
    margin: 0;
    background-color: var(--md-sys-color-background);
    color: var(--md-sys-color-on-background);
    overflow-y: auto;
    min-height: 100vh;
  }

  #smooth-wrapper { /* (Mevcut) */
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden; /* Genellikle content taşmalarını engellemek için body'de veya html'de olur */
  }

  #smooth-content { /* (Mevcut) */
    position: relative;
    width: 100%;
  }

  .main-content {
    position: relative;
    min-height: 100vh;
    background-color: var(--md-sys-color-background); /* Grain'in altındaki asıl arka plan rengi */
    z-index: 1; /* Footer gibi diğer ana bölümlere göre yığınlama sırası */
    border-bottom-left-radius: var(--md-sys-shape-corner-extra-large);
    border-bottom-right-radius: var(--md-sys-shape-corner-extra-large);
    box-shadow: var(--md-sys-elevation-level1); /* Material Design elevation */
    overflow: hidden; /* ::before pseudo-elementinin taşmasını engellemek için çok önemli */
    padding-top: 50px; /* Header yüksekliğinize göre ayarlayın */
    /* max-width ve margin:auto buradan kaldırıldı, .content-wrapper'a taşındı */
  }

  .main-content::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%; /* Ebeveynin tamamını kapla */
    height: 100%; /* Ebeveynin tamamını kapla */
    
    /* 
      z-index: 0; .main-content (z-index:1) içinde yeni bir yığınlama bağlamı oluşturur.
      Bu, ::before'u .main-content'in arka planının hemen üzerine,
      ancak .content-wrapper'ın (z-index:1 ile) altına yerleştirir.
    */
    z-index: 0; 
    pointer-events: none; /* Grain katmanının tıklama olaylarını engellememesi için */
    
    opacity: var(--current-grain-opacity); /* Temaya göre değişen opaklık */
    filter: var(--current-grain-filter);   /* Temaya göre değişen filtre (monokrom ve kontrast/parlaklık) */
    
    /* SVG'ye feColorMatrix eklendi (grain'i monokrom yapmak için) */
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 250 250' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    background-size: var(--grain-tile-size) var(--grain-tile-size);
    
    transition: opacity 0.3s ease, filter 0.3s ease; /* Tema değişikliğinde yumuşak geçiş için */
    will-change: opacity, filter; /* Performans ipucu */
    /* mix-blend-mode kaldırıldı, --grain-blend-mode tanımlı değildi. 
       İstenirse eklenebilir ama filter ile monokrom yapmak genellikle yeterlidir. */
  }

  /* @media (prefers-color-scheme: dark) bloğu kaldırıldı, 
     çünkü tema artık html.theme-light/dark sınıfları ile JS tarafından yönetiliyor. */

  .content-wrapper {
    position: relative;
    background-color: transparent; /* Grain efektinin .main-content arka planı üzerinde görünmesi için ŞART */
    
    /* 
      z-index: 1; .main-content (z-index:1) içinde yeni bir yığınlama bağlamı oluşturur
      ve .main-content::before'un (z-index:0) üzerinde kalmasını sağlar.
    */
    z-index: 1; 
    
    min-height: 100vh; /* Footer'ı sayfanın altına itmek için */
    width: 100%; /* Ebeveyninin genişliğine uyar */
    max-width: 1280px; /* İçeriğin maksimum genişliği (merkezleme için) */
    margin: 0 auto;    /* İçeriği yatayda ortalamak için */
    padding: 2rem;      /* İç boşluklar (mobil için aşağıda override edilebilir) */

    opacity: 1; /* Sayfa geçiş animasyonları için başlangıç durumu */
    transition: opacity 0.2s ease-in-out, transform 0.2s ease-in-out; /* Sayfa geçiş animasyonu */
    will-change: transform, opacity; /* Performans ipucu */
  }

  .content-wrapper.page-transitioning { /* (Mevcut) */
    opacity: 0;
    pointer-events: none;
  }

  .footer { /* (Mevcut) */
    position: relative;
    width: 100%;
    /* height: 100%; Bu genellikle içeriğe göre ayarlanmalı, sabit %100 sorun yaratabilir */
    z-index: 0; /* .main-content (z-index:1) ile aynı seviyede veya altında kalır */
    box-sizing: border-box;
    padding: 0;
    margin-top: -100vh; /* Parallax efekti için, dikkatli kullanılmalı */
    background-color: var(--md-sys-color-surface-container-lowest);
  }

  /* Responsive düzenlemeler (Mevcut) */
  @media (max-width: 768px) {
    .content-wrapper {
      padding: 1rem; /* Mobil cihazlar için daha az iç boşluk */
    }
  }

  /* Header Styles (Mevcut) */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50; /* En üst katmanda olması için yüksek z-index */
    transition: all 300ms ease-in-out;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    view-transition-name: none !important;
  }

  .site-header * {
    view-transition-name: none !important;
  }
</style>