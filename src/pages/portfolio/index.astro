---
import MainLayout from '@/layouts/MainLayout.astro';
import ProjectCard from '@/components/portfolio/ProjectCard.astro';
import TechnologyCard from '@/components/portfolio/TechnologyCard.astro';
import TestimonialCard from '@/components/portfolio/TestimonialCard.astro';

// Portfolio projeleri
const projects = [
  {
    title: "E-Ticaret Platformu",
    description: "Modern ve kullanıcı dostu bir e-ticaret platformu. React, Node.js ve MongoDB kullanılarak geliştirildi.",
    image: "/projects/ecommerce.jpg",
    tags: ["React", "Node.js", "MongoDB", "Tailwind CSS"],
    link: "/portfolio/ecommerce"
  },
  {
    title: "Blog Sitesi",
    description: "Kişisel blog sitesi. Next.js ve MDX kullanılarak geliştirildi. SEO optimizasyonu ve hızlı sayfa yüklemeleri.",
    image: "/projects/blog.jpg",
    tags: ["Next.js", "MDX", "Tailwind CSS", "Vercel"],
    link: "/portfolio/blog"
  },
  {
    title: "Task Yönetim Uygulaması",
    description: "Takım çalışması için geliştirilmiş task yönetim uygulaması. Gerçek zamanlı güncellemeler ve drag-drop özellikleri.",
    image: "/projects/taskmanager.jpg",
    tags: ["Vue.js", "Firebase", "Tailwind CSS", "WebSocket"],
    link: "/portfolio/taskmanager"
  }
];

// Teknoloji kartları
const technologies = [
  {
    name: "Frontend",
    items: [
      { name: "React", count: 15 },
      { name: "Vue.js", count: 8 },
      { name: "Next.js", count: 12 },
      { name: "Tailwind CSS", count: 20 }
    ]
  },
  {
    name: "Backend",
    items: [
      { name: "Node.js", count: 10 },
      { name: "Python", count: 6 },
      { name: "MongoDB", count: 8 },
      { name: "PostgreSQL", count: 5 }
    ]
  },
  {
    name: "DevOps",
    items: [
      { name: "Docker", count: 7 },
      { name: "AWS", count: 5 },
      { name: "CI/CD", count: 8 },
      { name: "Kubernetes", count: 3 }
    ]
  }
];

// Referanslar
const testimonials = [
  {
    name: "Ahmet Yılmaz",
    role: "CTO, TechCorp",
    content: "Olcan ile çalışmak harika bir deneyimdi. Projemizi zamanında ve bütçe dahilinde tamamladı. Teknik bilgisi ve problem çözme yetenekleri etkileyici.",
    image: "/testimonials/ahmet.jpg"
  },
  {
    name: "Ayşe Demir",
    role: "Product Manager, StartupX",
    content: "E-ticaret platformumuzun yeniden tasarımında gösterdiği yaratıcılık ve teknik uzmanlık için teşekkürler. Sonuçlar beklentilerimizin ötesindeydi.",
    image: "/testimonials/ayse.jpg"
  },
  {
    name: "Mehmet Kaya",
    role: "Founder, InnovateTech",
    content: "Olcan'ın modern web teknolojileri konusundaki bilgisi ve uygulama yeteneği projemizin başarısında kritik rol oynadı. Kesinlikle tekrar çalışmak isteriz.",
    image: "/testimonials/mehmet.jpg"
  }
];
---

<MainLayout title="Portfolyo | Olcan Ebrem">
  <main class="container mx-auto px-4 py-12">
    <!-- Hero Section -->
    <section class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Portfolyo</h1>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        Modern web teknolojileri kullanarak geliştirdiğim projeler ve edindiğim deneyimler.
      </p>
    </section>

    <!-- Projeler Section -->
    <section class="mb-20">
      <h2 class="text-3xl font-bold mb-8 text-center">Projeler</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </section>

    <!-- Teknolojiler Section -->
    <section class="mb-20">
      <h2 class="text-3xl font-bold mb-8 text-center">Teknolojiler</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {technologies.map((tech) => (
          <TechnologyCard {...tech} />
        ))}
      </div>
    </section>

    <!-- Referanslar Section -->
    <section class="mb-20">
      <h2 class="text-3xl font-bold mb-8 text-center">Referanslar</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {testimonials.map((testimonial) => (
          <TestimonialCard {...testimonial} />
        ))}
      </div>
    </section>
  </main>
</MainLayout>

<style>
  /* Sayfa özel stilleri buraya eklenebilir */
  section {
    scroll-margin-top: 2rem;
  }
</style>
