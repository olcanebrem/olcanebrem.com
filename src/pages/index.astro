---
import MainLayout from '@/layouts/MainLayout.astro'
import ContentSection from '@/layouts/ContentSection'
import GalleryContent from '@/layouts/GalleryContent'
import BannerContent from '@/layouts/BannerContent'
import MantineClientProvider from '@/components/providers/MantineClientProvider'
---

<script>
  import '@/components/RiveComponent.mjs'
</script>

<MainLayout>
  <MantineClientProvider>
    <div class="relative w-full h-[55vh] overflow-hidden">
      <!-- Background Image with Effects -->
      <div class="absolute inset-0 z-0 mx-auto max-w-5xl overflow-hidden p-6 md:p-10">
        <!-- Gradient Overlay -->
        <div class="absolute inset-0 backdrop-blur-sm rounded-[3rem] shadow-lg" style="background: linear-gradient(to bottom, transparent, var(--md-sys-color-surface-variant)/10);"></div>
        
        <!-- Mosaic Pattern -->
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808017_1px,transparent_1px),linear-gradient(to_bottom,#80808017_1px,transparent_1px)] bg-[size:20px_20px] opacity-20"></div>
        
        <!-- Image Container -->
        <div class="absolute inset-0 rounded-[3rem] overflow-hidden transition-all duration-500 hover:rounded-2xl group">
          <!-- Radial Mask -->
          <div class="absolute inset-0 [mask-image:radial-gradient(ellipse_at_center,black_75%,transparent_100%)]">
            <img 
              src="https://www.krea.ai/api/img?f=webp&i=https%3A%2F%2Ftest1-emgndhaqd0c9h2db.a01.azurefd.net%2Fimages%2F2443e2b0-c64d-46b6-b2de-3ddf4c8bd6c1.png"
              alt="Background"
              class="w-full h-full object-contain transform scale-110 -translate-y-6 transition-transform duration-700 ease-out hover:scale-125 hover:rotate-1 animate-[float_6s_ease-in-out_infinite] filter saturate-110 contrast-110"
            />
          </div>
        </div>
      </div>
      <!-- Rive Animation (on top) -->
      <div class="relative z-10 translate-y-12 h-[25vh]">
        <rive-animation></rive-animation>
      </div>
    </div>
    <div class="my-[30px]">
      <ContentSection client:load />
    </div>
    <div class="my-[30px]">
      <GalleryContent client:load />
    </div>
  </MantineClientProvider>
</MainLayout>

<style>
  .relative {
    position: relative;
  }
</style>
