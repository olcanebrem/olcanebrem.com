  }

  .output-placeholder-large {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1;
    border: 2px dashed var(--cyber-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-icon-large {
    font-size: 5rem;
    color: var(--cyber-border);
  }

  /* JSON Output */
  .json-output {
    margin-top: 2rem;
    border: 1px solid var(--cyber-border);
    background: rgba(26, 26, 26, 0.5);
  }

  .json-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid var(--cyber-border);
  }

  .json-label {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--cyber-accent);
    letter-spacing: 0.15em;
    font-family: "Courier New", monospace;
  }

  .copy-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: transparent;
    border: 1px solid var(--cyber-border);
    color: var(--cyber-text-dim);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    font-family: "Courier New", monospace;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .copy-btn:hover {
    border-color: var(--cyber-accent);
    color: var(--cyber-accent);
  }

  .json-code {
    padding: 1.5rem;
    margin: 0;
    color: var(--cyber-text);
    font-size: 0.75rem;
    font-family: "Courier New", monospace;
    line-height: 1.6;
    overflow-x: auto;
  }

  .json-code code {
    color: var(--cyber-text);
  }

  /* Cost Info */
  .cost-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 1rem;
    border: 1px solid var(--cyber-border);
    background: rgba(26, 26, 26, 0.3);
  }

  .cost-label {
    font-size: 0.65rem;
    color: var(--cyber-text-dim);
    font-family: "Courier New", monospace;
    letter-spacing: 0.1em;
  }

  .cost-value {
    font-size: 0.875rem;
    color: var(--cyber-accent);
    font-weight: 700;
    font-family: "Courier New", monospace;
  }

  .cost-unit {
    font-size: 0.65rem;
    color: var(--cyber-text-dim);
    font-family: "Courier New", monospace;
  }

  /* Node Graph Container */
  .node-graph-container {
    padding: 2rem;
    min-height: 600px;
  }

  /* API Documentation */
  .api-documentation {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .api-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .api-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--cyber-accent);
    letter-spacing: 0.15em;
    font-family: "Courier New", monospace;
  }

  .api-text {
    font-size: 0.8rem;
    color: var(--cyber-text);
    font-family: "Courier New", monospace;
    line-height: 1.6;
  }

  .code-block {
    padding: 1rem;
    background: rgba(26, 26, 26, 0.5);
    border: 1px solid var(--cyber-border);
    font-family: "Courier New", monospace;
    font-size: 0.75rem;
    color: var(--cyber-accent);
    overflow-x: auto;
  }

  /* Execute Button */
  .execute-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.25rem;
    background: var(--cyber-accent);
    border: 1px solid var(--cyber-accent);
    color: var(--cyber-black);
    font-size: 0.875rem;
    font-weight: 900;
    letter-spacing: 0.15em;
    font-family: "Courier New", monospace;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 1rem;
  }

  .execute-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 30px rgba(0, 255, 136, 0.6);
  }

  .btn-icon {
    font-size: 1rem;
  }

  .execute-glow {
    position: absolute;
    inset: -2px;
    background: linear-gradient(90deg, var(--cyber-accent), var(--cyber-blue));
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: -1;
  }

  .execute-btn:hover .execute-glow {
    opacity: 0.3;
  }

  /* Node Graph */
  .node-graph {
    position: relative;
    height: 400px;
    background: rgba(10, 10, 10, 0.5);
    border: 1px solid var(--cyber-border);
  }

  .connection-lines {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
  }

  .node {
    position: absolute;
    min-width: 120px;
    background: var(--cyber-gray);
    border: 1px solid var(--cyber-border);
    padding: 0.75rem;
    transition: all 0.3s ease;
  }

  .node:hover {
    border-color: var(--cyber-accent);
    transform: scale(1.05);
  }

  .node.active {
    border-color: var(--cyber-accent);
    box-shadow: 0 0 15px rgba(0, 255, 136, 0.3);
  }

  .node-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .node-dot {
    width: 6px;
    height: 6px;
    background: var(--cyber-accent);
    border-radius: 50%;
  }

  .node-header span:last-child {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--cyber-text);
    font-family: "Courier New", monospace;
  }

  .node-port {
    width: 10px;
    height: 10px;
    background: var(--cyber-accent);
    border: 1px solid var(--cyber-border);
    position: absolute;
    border-radius: 50%;
  }

  .node-port.input {
    left: -6px;
    top: 50%;
    transform: translateY(-50%);
  }

  .node-port.output {
    right: -6px;
    top: 50%;
    transform: translateY(-50%);
  }

  .node-status {
    font-size: 0.6rem;
    color: var(--cyber-accent);
    font-family: "Courier New", monospace;
    margin-top: 0.5rem;
  }

  /* Output Area */
  .output-area {
    flex: 1;
    border: 1px solid var(--cyber-border);
    background: rgba(10, 10, 10, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
  }

  .output-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .placeholder-icon {
    font-size: 3rem;
    color: var(--cyber-border);
  }

  .placeholder-text {
    font-size: 0.75rem;
    color: var(--cyber-text-dim);
    letter-spacing: 0.15em;
    font-family: "Courier New", monospace;
  }

  .processing-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .processing-bar {
    width: 150px;
    height: 4px;
    background: var(--cyber-border);
    position: relative;
    overflow: hidden;
  }

  .processing-text {
    font-size: 0.65rem;
    color: var(--cyber-accent);
    font-family: "Courier New", monospace;
  }

  /* Output Info */
  .output-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--cyber-border);
    background: rgba(26, 26, 26, 0.3);
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .info-label {
    font-size: 0.65rem;
    color: var(--cyber-text-dim);
    font-family: "Courier New", monospace;
    letter-spacing: 0.1em;
  }

  .info-value {
    font-size: 0.75rem;
    color: var(--cyber-accent);
    font-family: "Courier New", monospace;
  }

  /* Output Actions */
  .output-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .output-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem;
    background: transparent;
    border: 1px solid var(--cyber-border);
    color: var(--cyber-text-dim);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    font-family: "Courier New", monospace;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .output-btn:not(:disabled):hover {
    border-color: var(--cyber-accent);
    color: var(--cyber-accent);
  }

  .output-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  /* Status Bar */
  .comfyui-status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--cyber-border);
    background: rgba(26, 26, 26, 0.5);
  }

  .status-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: var(--cyber-text-dim);
    border-radius: 50%;
  }

  .status-dot.active {
    background: var(--cyber-accent);
    box-shadow: 0 0 10px var(--cyber-accent);
  }

  .status-text {
    font-size: 0.7rem;
    color: var(--cyber-text);
    letter-spacing: 0.1em;
    font-family: "Courier New", monospace;
  }

  .status-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .status-item {
    font-size: 0.65rem;
    color: var(--cyber-text-dim);
    font-family: "Courier New", monospace;
  }

  .status-divider {
    color: var(--cyber-border);
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .comfyui-workspace {
      grid-template-columns: 1fr;
    }

    .graph-panel {
      order: -1;
    }
  }

  @media (max-width: 768px) {
    .menu-group {
      flex-wrap: wrap;
    }

    .menu-btn {
      padding: 0.5rem 0.75rem;
      font-size: 0.65rem;
    }

    .comfyui-status {
      flex-direction: column;
      gap: 0.75rem;
      align-items: flex-start;
    }

    .node-graph {
      height: 300px;
    }
  }

  /* Hero Banner */
  .hero-banner {
    position: relative;
    min-height: 100vh;
    background-color: var(--cyber-black);
    background-image:
      linear-gradient(103.39deg, rgba(0, 10, 20, 0.95) 21.49%, rgba(0, 10, 20, 0) 66.42%),
      radial-gradient(ellipse at top right, rgba(0, 255, 136, 0.1) 0%, transparent 50%),
      radial-gradient(ellipse at bottom left, rgba(0, 217, 255, 0.1) 0%, transparent 50%);
    background-position: 50% 100%, 100% 0%, 0% 100%;
    background-repeat: no-repeat;
    background-size: cover;
    overflow: visible;
    display: flex;
    align-items: center;
    padding: 2rem;
    gap: 4rem;
  }

  /* Left Side - Database Schema (40%) */
  .hero-left {
    flex: 0 0 40%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    overflow: visible;
    position: relative;
  }

  /* Heatmap Container */
  .heatmap-container {
    width: 100%;
    min-height: 100vh;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .heatmap-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(0, 255, 136, 0.2);
  }

  .mono-text {
    font-family: 'Courier New', monospace;
    font-size: 1.2rem;
    font-weight: bold;
    color: var(--cyber-accent);
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .heatmap-year {
    font-family: 'Courier New', monospace;
    font-size: 1rem;
    color: var(--cyber-text-dim);
  }

  .heatmap-months {
    display: flex;
    flex-direction: row;
    gap: 2rem;
    width: 100%;
    align-items: flex-start;
  }

  .heatmap-month {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .month-label {
    font-family: 'Courier New', monospace;
    font-size: 0.85rem;
    font-weight: bold;
    color: var(--cyber-blue);
    letter-spacing: 1px;
    text-align: center;
  }

  .days-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 4px;
  }

  .day-box {
    aspect-ratio: 1;
    background: var(--cyber-accent);
    border: 1px solid rgba(0, 255, 136, 0.3);
    border-radius: 2px;
  }

  /* Right Side - Content (60%) */
  .hero-right {
    flex: 0 0 60%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    z-index: 10;
  }

  /* Static Grid Overlay - No Animation */
  .grid-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: linear-gradient(var(--cyber-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--cyber-border) 1px, transparent 1px);
    background-size: 50px 50px;
    opacity: 0.2;
  }

  /* Circuit Lines - Removed for Performance */
  .circuit-lines {
    display: none;
  }

  /* Tech Badge */
  .tech-badge {
    position: relative;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.5rem;
    border: 1px solid var(--cyber-accent);
    background: var(--cyber-accent-dim);
    color: var(--cyber-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 2rem;
  }

  .hero-title,
  .hero-description,
  .hero-actions,
  .stats-grid {
    position: relative;
    z-index: 10;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--cyber-accent);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--cyber-accent);
  }

  /* Hero Title */
  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 100%;
    text-align: left;
  }

  .glitch-text {
    color: var(--cyber-white);
    position: relative;
    letter-spacing: 0.1em;
  }

  /* Glitch effect removed for performance */

  .gradient-text {
    background: linear-gradient(
      90deg,
      var(--cyber-accent) 0%,
      var(--cyber-blue) 50%,
      var(--cyber-purple) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 0.05em;
  }

  .subtitle-line {
    font-size: clamp(0.875rem, 2vw, 1.25rem);
    font-weight: 400;
    color: var(--cyber-text-dim);
    letter-spacing: 0.3em;
  }

  /* Hero Description */
  .hero-description {
    font-size: clamp(1rem, 2vw, 1.5rem);
    color: var(--cyber-text);
    max-width: 700px;
    margin-bottom: 3rem;
    line-height: 1.6;
  }

  /* Cyber Buttons */
  .hero-actions {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 4rem;
  }

  .btn-cyber {
    position: relative;
    padding: 1.25rem 2.5rem;
    border: 1px solid var(--cyber-border);
    background: transparent;
    color: var(--cyber-text);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-decoration: none;
    overflow: hidden;
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
    clip-path: polygon(
      10px 0,
      100% 0,
      100% calc(100% - 10px),
      calc(100% - 10px) 100%,
      0 100%,
      0 10px
    );
  }

  .btn-cyber.large {
    padding: 1.5rem 3rem;
    font-size: 1rem;
  }

  .btn-cyber.btn-primary {
    border-color: var(--cyber-accent);
    color: var(--cyber-accent);
  }

  .btn-cyber.btn-secondary {
    border-color: var(--cyber-blue);
    color: var(--cyber-blue);
  }

  .btn-content {
    position: relative;
    z-index: 2;
  }

  .btn-glow {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      var(--cyber-accent-dim),
      transparent
    );
    transition: left 0.5s ease;
  }

  .btn-cyber:hover .btn-glow {
    left: 100%;
  }

  .btn-cyber.btn-primary:hover {
    background: var(--cyber-accent-dim);
    box-shadow: 0 0 30px var(--cyber-accent-dim);
  }

  .btn-cyber.btn-secondary:hover {
    background: rgba(0, 217, 255, 0.1);
    box-shadow: 0 0 30px rgba(0, 217, 255, 0.3);
  }

  /* Stats Grid */
  .stats-grid {
    display: flex;
    gap: 2rem;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: wrap;
    padding: 2rem;
    border: 1px solid var(--cyber-border);
    background: rgba(26, 26, 26, 0.5);
    backdrop-filter: blur(10px);
    clip-path: polygon(
      20px 0,
      100% 0,
      100% calc(100% - 20px),
      calc(100% - 20px) 100%,
      0 100%,
      0 20px
    );
  }

  .stat-box {
    text-align: center;
  }

  .stat-number {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 900;
    color: var(--cyber-white);
    font-family: "Courier New", monospace;
  }

  .stat-number .accent {
    color: var(--cyber-accent);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--cyber-text-dim);
    letter-spacing: 2px;
    margin-top: 0.5rem;
  }

  .stat-divider {
    width: 1px;
    height: 60px;
    background: var(--cyber-border);
  }

  /* Floating Elements - Removed for Performance */
  .floating-elements {
    display: none;
  }

  /* Systems Section */
  .systems-section {
    padding: 8rem 2rem;
    background: var(--cyber-darker);
    position: relative;
  }

  .section-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
    position: relative;
  }

  .header-line {
    width: 100px;
    height: 1px;
    background: var(--cyber-accent);
    margin: 0 auto 2rem;
    box-shadow: 0 0 10px var(--cyber-accent);
  }

  .section-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--cyber-accent);
    letter-spacing: 3px;
    margin-bottom: 1rem;
    font-family: "Courier New", monospace;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 900;
    color: var(--cyber-white);
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .section-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--cyber-text-dim);
    max-width: 700px;
    margin: 0 auto;
  }

  /* Systems Grid */
  .systems-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .system-card {
    position: relative;
    padding: 2rem;
    background: var(--cyber-gray);
    border: 1px solid var(--cyber-border);
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
    overflow: hidden;
  }

  .card-border {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 1px solid transparent;
    transition: border-color 0.3s ease;
    pointer-events: none;
  }

  .card-glow {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(
      circle,
      var(--cyber-accent-dim) 0%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .system-card:hover {
    border-color: var(--cyber-accent);
    transform: translateY(-5px);
    box-shadow: 0 10px 40px rgba(0, 255, 136, 0.2);
  }

  .system-card:hover .card-border {
    border-color: var(--cyber-accent);
    box-shadow: inset 0 0 20px var(--cyber-accent-dim);
  }

  .system-card:hover .card-glow {
    opacity: 0.1;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .system-icon {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--cyber-border);
    background: var(--cyber-dark);
    color: var(--cyber-accent);
  }

  .system-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    color: var(--cyber-accent);
    letter-spacing: 1px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--cyber-accent);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--cyber-accent);
  }

  .system-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--cyber-white);
    margin-bottom: 1rem;
    letter-spacing: 1px;
  }

  .system-desc {
    font-size: 0.95rem;
    color: var(--cyber-text);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .tech-specs {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .spec {
    font-size: 0.65rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--cyber-border);
    color: var(--cyber-text-dim);
    letter-spacing: 1px;
    font-family: "Courier New", monospace;
  }

  /* Terminal Section */
  .terminal-section {
    padding: 8rem 2rem;
    background: var(--cyber-black);
  }

  .terminal-wrapper {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    background: var(--cyber-dark);
    border: 1px solid var(--cyber-border);
    box-shadow: 0 20px 60px rgba(0, 255, 136, 0.1);
  }

  .terminal-border {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 1px solid var(--cyber-accent);
    opacity: 0.3;
    pointer-events: none;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--cyber-gray);
    border-bottom: 1px solid var(--cyber-border);
  }

  .terminal-controls {
    display: flex;
    gap: 0.5rem;
  }

  .control-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot-red {
    background: #ff5f56;
  }
  .dot-yellow {
    background: #ffbd2e;
  }
  .dot-green {
    background: #27c93f;
  }

  .terminal-title {
    font-size: 0.875rem;
    color: var(--cyber-text-dim);
    font-family: "Courier New", monospace;
  }

  .terminal-body {
    padding: 2rem;
    font-family: "Courier New", monospace;
    font-size: 0.95rem;
  }

  .terminal-line {
    margin-bottom: 0.75rem;
    color: var(--cyber-text);
  }

  .terminal-line.output {
    color: var(--cyber-text-dim);
    padding-left: 1rem;
  }

  .prompt {
    color: var(--cyber-accent);
    margin-right: 0.5rem;
  }

  .command {
    color: var(--cyber-blue);
  }

  .success {
    color: var(--cyber-accent);
    font-weight: 700;
  }

  .cursor {
    color: var(--cyber-white);
  }

  /* Data Grid Section - Sci-Fi Intelligence Dashboard */
  .data-grid-section {
    padding: 8rem 2rem;
    background: #000000;
    position: relative;
  }

  /* Tech Grid Hero Banner */
  .tech-grid-hero {
    position: relative;
    height: 300px;
    margin-bottom: 4rem;
    border: 1px solid var(--cyber-border);
    background: linear-gradient(135deg, #0a0a0a 0%, #000000 100%);
    overflow: hidden;
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
        rgba(51, 51, 51, 0.3) 1px,
        transparent 1px
      ),
      linear-gradient(90deg, rgba(51, 51, 51, 0.3) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.5;
  }

  .circuit-lines {
    position: absolute;
    inset: 0;
  }

  .circuit-h,
  .circuit-v {
    position: absolute;
    background: var(--cyber-accent);
    opacity: 0.4;
    box-shadow: 0 0 10px var(--cyber-accent);
  }

  .circuit-h {
    height: 1px;
    left: 0;
  }

  .circuit-v {
    width: 1px;
    top: 0;
  }

  .floating-nodes {
    position: absolute;
    inset: 0;
  }

  .floating-nodes .node {
    position: absolute;
    width: 8px;
    height: 8px;
    background: var(--cyber-accent);
    border-radius: 50%;
    box-shadow: 0 0 20px var(--cyber-accent);
  }

  .node-pulse {
    position: absolute;
    inset: -4px;
    border: 2px solid var(--cyber-accent);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(2);
      opacity: 0;
    }
  }

  /* Stats Infographic Grid */
  .stats-infographic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  /* Info Panel - Base */
  .info-panel {
    position: relative;
    background: #0a0a0a;
    border: 1px solid var(--cyber-border);
    padding: 1.5rem;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .info-panel:hover {
    border-color: rgba(0, 255, 136, 0.5);
    box-shadow: 0 0 20px rgba(0, 255, 136, 0.1);
  }

  .info-panel.large {
    grid-column: span 2;
  }

  .panel-border {
    position: absolute;
    inset: 0;
    border: 1px solid transparent;
    pointer-events: none;
  }

  .animated-border {
    background: linear-gradient(
      90deg,
      transparent,
      var(--cyber-accent),
      transparent
    );
    background-size: 200% 100%;
    animation: borderShift 3s linear infinite;
    opacity: 0.3;
  }

  @keyframes borderShift {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

  .accent-border {
    border-color: var(--cyber-accent);
  }

  /* Panel Header */
  .panel-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--cyber-border);
  }

  .panel-icon {
    color: var(--cyber-accent);
    font-size: 0.875rem;
  }

  .panel-title {
    font-family: "Courier New", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--cyber-text);
    font-weight: 700;
  }

  .status-indicator {
    margin-left: auto;
    font-size: 0.65rem;
    font-family: "Courier New", monospace;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--cyber-border);
    background: rgba(26, 26, 26, 0.5);
  }

  .status-indicator.live {
    color: var(--cyber-accent);
    border-color: var(--cyber-accent);
  }

  .monitor-count {
    margin-left: auto;
    font-family: "Courier New", monospace;
    color: var(--cyber-accent);
    font-size: 0.875rem;
    font-weight: 700;
  }

  /* Panel Content */
  .panel-content {
    font-family: "Courier New", monospace;
  }

  .panel-content.centered {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  /* Data Row */
  .data-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(51, 51, 51, 0.3);
  }

  .data-row:last-of-type {
    border-bottom: none;
  }

  .data-label {
    font-size: 0.7rem;
    color: var(--cyber-text-dim);
    letter-spacing: 0.1em;
  }

  .data-value {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--cyber-white);
  }

  .data-value small {
    font-size: 0.7rem;
    color: var(--cyber-accent);
    margin-left: 0.25rem;
  }

  /* Mini Chart */
  .mini-chart {
    display: flex;
    gap: 0.375rem;
    height: 60px;
    align-items: flex-end;
    margin-top: 1.5rem;
  }

  .chart-bar {
    flex: 1;
    background: var(--cyber-accent);
    opacity: 0.6;
    border: 1px solid var(--cyber-accent);
    height: calc(var(--height) * 100%);
    transition: opacity 0.3s ease;
  }

  .info-panel:hover .chart-bar {
    opacity: 1;
  }

  /* Reliability Display */
  .reliability-display {
    text-align: center;
    padding: 2rem 0;
  }

  .reliability-value {
    font-size: 3rem;
    font-weight: 900;
    color: var(--cyber-white);
    line-height: 1;
  }

  .reliability-value .percent {
    font-size: 1.5rem;
    color: var(--cyber-accent);
  }

  .reliability-label {
    font-size: 0.7rem;
    color: var(--cyber-text-dim);
    letter-spacing: 0.15em;
    margin-top: 0.5rem;
  }

  /* Schema Diagram */
  .schema-diagram {
    position: relative;
    height: 80px;
    margin-top: 1.5rem;
  }

  .schema-line {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--cyber-border);
  }

  .schema-line:nth-child(2) {
    bottom: 33%;
  }

  .schema-line:nth-child(3) {
    bottom: 66%;
  }

  .schema-node {
    position: absolute;
    bottom: 0;
    left: calc(var(--pos) * 100%);
    transform: translateX(-50%);
    width: 12px;
    height: 12px;
    background: var(--cyber-accent);
    border: 2px solid #0a0a0a;
    border-radius: 50%;
    box-shadow: 0 0 10px var(--cyber-accent);
  }

  .node-label {
    position: absolute;
    top: -20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.6rem;
    color: var(--cyber-text-dim);
    white-space: nowrap;
  }

  /* Data Table */
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
  }

  .data-table th {
    text-align: left;
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--cyber-border);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--cyber-text-dim);
    font-weight: 700;
  }

  .data-table td {
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid rgba(51, 51, 51, 0.3);
    color: var(--cyber-text);
  }

  .data-table tbody tr:last-child td {
    border-bottom: none;
  }

  .status-badge {
    font-size: 0.65rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid;
    letter-spacing: 0.1em;
  }

  .status-badge.ok {
    color: var(--cyber-accent);
    border-color: var(--cyber-accent);
    background: rgba(0, 255, 136, 0.1);
  }

  /* CTA Module */
  .cta-icon {
    font-size: 2rem;
    color: var(--cyber-accent);
  }

  .cta-heading {
    font-size: 1rem;
    font-weight: 700;
    color: var(--cyber-white);
    letter-spacing: 0.1em;
    margin: 0;
  }

  .cta-text {
    font-size: 0.75rem;
    color: var(--cyber-text-dim);
    margin: 0;
    font-family: "Courier New", monospace;
  }

  .divider-line {
    width: 100%;
    height: 1px;
    background: var(--cyber-border);
    margin: 0.5rem 0;
  }

  .cta-btn-small {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.5rem;
    background: transparent;
    border: 1px solid var(--cyber-accent);
    color: var(--cyber-accent);
    font-family: "Courier New", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .cta-btn-small:hover {
    background: var(--cyber-accent);
    color: #000000;
    box-shadow: 0 0 20px var(--cyber-accent);
  }

  .btn-arrow {
    transition: transform 0.3s ease;
  }

  .cta-btn-small:hover .btn-arrow {
    transform: translateX(5px);
  }

  /* Connection Graph */
  .connection-graph {
    margin-bottom: 1rem;
  }

  .graph-svg {
    width: 100%;
    height: 80px;
  }

  .connection-stats {
    display: flex;
    gap: 1.5rem;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    color: var(--cyber-text);
  }

  .stat-dot {
    width: 6px;
    height: 6px;
    background: var(--cyber-accent);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--cyber-accent);
  }

  .stat-dot.dim {
    background: var(--cyber-text-dim);
    box-shadow: none;
  }

  /* Architecture Diagram */
  .architecture-diagram {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 0;
  }

  .arch-layer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .arch-box {
    padding: 0.75rem 2rem;
    border: 1px solid var(--cyber-border);
    background: rgba(26, 26, 26, 0.5);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--cyber-text);
    min-width: 120px;
    text-align: center;
  }

  .arch-connector {
    width: 1px;
    height: 20px;
    background: var(--cyber-border);
  }

  /* Responsive */
  @media (max-width: 968px) {
    .stats-infographic-grid {
      grid-template-columns: 1fr;
    }

    .info-panel.large {
      grid-column: span 1;
    }

    .tech-grid-hero {
      height: 200px;
    }
  }

  /* Image Gallery Section */
  .image-gallery-section {
    width: 100%;
    background: var(--cyber-black);
    padding: 0;
    margin: 0;
    overflow: hidden;
    height: 500px;
  }

  .masonry-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(5, 100px);
    grid-auto-flow: dense;
    gap: 0;
    height: 500px;
    width: 100%;
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    background: var(--cyber-black);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.3s ease, transform 0.5s ease, filter 0.5s ease;
    filter: grayscale(0.3) brightness(0.9);
  }

  .gallery-item:hover img {
    transform: scale(1.05);
    filter: grayscale(0) brightness(1);
  }

  /* Responsive adjustments */
  @media (max-width: 1200px) {
    .image-gallery-section {
      height: 400px;
    }

    .masonry-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(5, 80px);
      height: 400px;
    }
  }

  @media (max-width: 768px) {
    .image-gallery-section {
      height: 300px;
    }

    .masonry-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(5, 60px);
      height: 300px;
    }

    .gallery-item[style*="span 3"] {
      grid-row: span 2 !important;
    }

    .gallery-item[style*="span 2"][style*="column"] {
      grid-column: span 1 !important;
    }
  }

  @media (max-width: 480px) {
    .image-gallery-section {
      height: 250px;
    }

    .masonry-grid {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(5, 50px);
      height: 250px;
    }

    .gallery-item {
      grid-row: span 1 !important;
      grid-column: span 1 !important;
    }
  }

  /* Empower Section - Layered SVG Layout */
  .empower-section {
    padding: 8rem 2rem;
    background: #000000;
    position: relative;
    overflow: hidden;
  }

  .empower-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 4rem;
  }

  /* Left Content (60%) */
  .empower-content {
    flex: 0 0 60%;
  }

  .empower-header {
    margin-bottom: 3rem;
  }

  .empower-tag {
    font-size: 0.7rem;
    color: var(--cyber-text-dim);
    letter-spacing: 0.2em;
    font-family: "Courier New", monospace;
    display: block;
    margin-bottom: 1.5rem;
  }

  .empower-title {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--cyber-white);
    font-weight: 400;
    line-height: 1.3;
    max-width: 700px;
  }

  /* Items List */
  .empower-items {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .empower-item {
    border-left: 1px solid var(--cyber-border);
    padding-left: 2rem;
    transition: border-color 0.3s ease;
  }

  .empower-item:hover {
    border-left-color: var(--cyber-accent);
  }

  .item-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .item-indicator {
    width: 12px;
    height: 12px;
    border: 2px solid;
    background: transparent;
  }

  .item-indicator.yellow {
    border-color: #cfff00;
    background: rgba(207, 255, 0, 0.2);
  }

  .item-indicator.blue {
    border-color: #00d9ff;
    background: rgba(0, 217, 255, 0.2);
  }

  .item-indicator.orange {
    border-color: #ff6b00;
    background: rgba(255, 107, 0, 0.2);
  }

  .item-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    font-family: "Courier New", monospace;
    color: var(--cyber-white);
  }

  .item-description {
    color: var(--cyber-text);
    line-height: 1.6;
    font-size: 0.95rem;
    margin: 0;
  }

  /* Right SVG Visual (40%) */
  .empower-visual {
    flex: 0 0 40%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 500px;
  }

  .layered-svg {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 30px rgba(0, 255, 136, 0.1));
  }

  /* Responsive */
  @media (max-width: 968px) {
    .empower-container {
      flex-direction: column;
      gap: 3rem;
    }

    .empower-content,
    .empower-visual {
      flex: 0 0 100%;
    }

    .empower-visual {
      min-height: 400px;
    }
  }

  @media (max-width: 640px) {
    .empower-title {
      font-size: 1.75rem;
    }

    .empower-item {
      padding-left: 1rem;
    }

    .empower-visual {
      min-height: 300px;
    }
  }

  /* Features Section */
  .features-section {
    padding: 8rem 2rem;
    background: var(--cyber-black);
  }

  .features-header {
    margin-bottom: 4rem;
  }

  .features-tag {
    font-size: 0.75rem;
    color: var(--cyber-text-dim);
    letter-spacing: 0.2em;
    font-family: "Courier New", monospace;
    display: block;
    margin-bottom: 1rem;
  }

  .features-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--cyber-white);
    font-weight: 900;
    margin-bottom: 1.5rem;
  }

  .features-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--cyber-text);
    max-width: 800px;
    line-height: 1.6;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .feature-card {
    position: relative;
    padding: 2.5rem;
    background: var(--cyber-gray);
    border: 1px solid var(--cyber-border);
    transition: border-color 0.3s ease;
  }

  .feature-card-wide {
    grid-column: 1 / -1;
  }

  .feature-card:hover {
    border-color: var(--cyber-accent);
  }

  .feature-border {
    position: absolute;
    inset: 0;
    border: 1px solid var(--cyber-accent);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .feature-card:hover .feature-border {
    opacity: 0.5;
  }

  .feature-label {
    display: block;
    font-size: 0.65rem;
    color: var(--cyber-accent);
    letter-spacing: 0.15em;
    margin-bottom: 1.5rem;
    font-family: "Courier New", monospace;
  }

  .feature-title {
    font-size: 1.75rem;
    color: var(--cyber-white);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .feature-desc {
    color: var(--cyber-text);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .feature-preview {
    margin-top: 2rem;
  }

  .code-preview,
  .terminal-preview {
    background: var(--cyber-black);
    border: 1px solid var(--cyber-border);
    padding: 1.5rem;
    font-family: "Courier New", monospace;
    font-size: 0.875rem;
  }

  .code-line,
  .terminal-line {
    margin-bottom: 0.5rem;
  }

  .code-key {
    color: var(--cyber-blue);
  }

  .code-func {
    color: var(--cyber-accent);
  }

  .code-str {
    color: var(--cyber-purple);
  }

  .prompt {
    color: var(--cyber-accent);
    margin-right: 0.5rem;
  }

  .link {
    color: var(--cyber-blue);
    text-decoration: underline;
  }

  .visual-preview {
    height: 200px;
    background: var(--cyber-dark);
    border: 1px solid var(--cyber-border);
  }

  .automation-flow {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 2rem;
    background: var(--cyber-black);
    border: 1px solid var(--cyber-border);
    overflow-x: auto;
  }

  .flow-node {
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--cyber-accent);
    background: var(--cyber-gray);
    color: var(--cyber-accent);
    font-size: 0.75rem;
    font-family: "Courier New", monospace;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

