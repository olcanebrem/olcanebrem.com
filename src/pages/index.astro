---
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout title="Advanced Tech Systems | Cyber Operations">
  <script>
    // Add fullscreen-page class to body for full-screen experience
    document.body.classList.add("fullscreen-page");

    // Remove class when navigating away
    document.addEventListener("astro:before-preparation", () => {
      document.body.classList.remove("fullscreen-page");
    });
  </script>
  <!-- Futuristic Hero Banner -->
  <section class="hero-banner">
    <div class="grid-overlay"></div>

    <!-- Left Side: Monthly Heatmap Visualization (40%) -->
    <div class="hero-left">
      <div class="heatmap-container">
        <div class="heatmap-title">
          <span class="mono-text">Activity Heatmap</span>
          <span class="heatmap-year">2025</span>
        </div>
        <div class="heatmap-months">
          {['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL'].map(month => (
            <div class="heatmap-month">
              <div class="month-label">{month}</div>
              <div class="days-grid">
                {Array.from({ length: 30 }).map(() => {
                  const saturation = Math.random() * 0.9 + 0.1;
                  return <div class="day-box" style={`opacity: ${saturation}`}></div>;
                })}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Right Side: Content (60%) -->
    <div class="hero-right">
      <div class="tech-badge">
        <span class="badge-dot"></span>
        <span>SYSTEM ONLINE</span>
      </div>

      <h1 class="hero-title">
        <span class="glitch-text" data-text="ADVANCED">ADVANCED</span>
        <span class="gradient-text">CYBER OPERATIONS</span>
        <span class="subtitle-line">NEXT-GENERATION TECHNOLOGY PLATFORM</span>
      </h1>

      <p class="hero-description">
        Engineered for precision. Built for scale. Optimized for the future.
      </p>

      <div class="hero-actions">
        <a href="#" class="btn-cyber btn-primary">
          <span class="btn-content">INITIALIZE SYSTEM</span>
          <span class="btn-glow"></span>
        </a>
        <a href="#" class="btn-cyber btn-secondary">
          <span class="btn-content">ACCESS TERMINAL</span>
          <span class="btn-glow"></span>
        </a>
      </div>

      <div class="stats-grid">
        <div class="stat-box">
          <div class="stat-number">99.9<span class="accent">%</span></div>
          <div class="stat-label">UPTIME</div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-box">
          <div class="stat-number">50K<span class="accent">+</span></div>
          <div class="stat-label">OPERATIONS</div>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-box">
          <div class="stat-number">24<span class="accent">/</span>7</div>
          <div class="stat-label">MONITORING</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ComfyUI Integration Section -->
  <section class="comfyui-section">
    <div class="section-container">
      <!-- Model Header -->
      <div class="model-header">
        <div class="model-title-row">
          <h1 class="model-name">
            <span class="model-namespace">cyber-ops/</span>
            <span class="model-id">flux-pro</span>
          </h1>
          <button class="copy-model-btn" title="Copy model ID">
            <span>📋</span>
          </button>
          <button class="info-btn" title="Information">
            <span>ⓘ</span>
          </button>
        </div>

        <p class="model-description">
          The most advanced AI image generation model. Ultra-realistic outputs
          with unprecedented control over composition, style, and detail.
        </p>

        <div class="model-badges">
          <span class="badge badge-inference">
            <span class="badge-icon">⚡</span>
            <span>Inference</span>
          </span>
          <span class="badge badge-commercial">
            <span class="badge-icon">$</span>
            <span>Commercial use</span>
          </span>
          <span class="badge badge-partner">
            <span class="badge-icon">★</span>
            <span>Partner</span>
          </span>
        </div>

        <div class="model-tabs">
          <button class="model-tab active">Playground</button>
          <button class="model-tab">API</button>
          <button class="model-tab">Examples</button>
        </div>
      </div>

      <div class="comfyui-interface">
        <!-- Top Menu Bar -->
        <div class="comfyui-menu">
          <div class="menu-group">
            <button class="menu-btn active" data-tab="playground">
              <span class="menu-icon">◆</span>
              <span>PLAYGROUND</span>
            </button>
            <button class="menu-btn" data-tab="nodegraph">
              <span class="menu-icon">◆</span>
              <span>NODE GRAPH</span>
            </button>
            <button class="menu-btn" data-tab="api">
              <span class="menu-icon">◆</span>
              <span>API</span>
            </button>
          </div>
          <div class="menu-actions">
            <button class="action-btn">
              <span>⚙</span>
              <span>SETTINGS</span>
            </button>
            <button class="action-btn primary">
              <span>🔑</span>
              <span>GET API KEY</span>
            </button>
          </div>
        </div>

        <!-- Playground Tab -->
        <div class="tab-content active" id="playground-tab">
          <div class="comfyui-workspace two-column">
            <!-- Left Panel - Input -->
            <div class="workspace-panel input-panel">
              <div class="panel-content">
                <!-- Prompt -->
                <div class="parameter-group">
                  <label class="param-label">
                    <span>PROMPT</span>
                    <span class="param-count">0/500</span>
                  </label>
                  <textarea
                    class="param-input large"
                    placeholder="Close-up portrait of a majestic iguana with vibrant blue-green scales, piercing amber eyes..."
                  ></textarea>
                </div>

                <!-- Additional Settings Accordion -->
                <details class="settings-accordion">
                  <summary class="accordion-header">
                    <span>⚙ ADDITIONAL SETTINGS</span>
                    <span class="accordion-arrow">▼</span>
                  </summary>
                  <div class="accordion-content">
                    <!-- Upload Area -->
                    <div class="parameter-group">
                      <label class="param-label">INPUT IMAGE (OPTIONAL)</label>
                      <div class="upload-area compact">
                        <div class="upload-icon small">⬆</div>
                        <span class="upload-text">CLICK TO UPLOAD</span>
                        <span class="upload-formats"
                          >PNG, JPG, WEBP • MAX 10MB</span
                        >
                      </div>
                    </div>

                    <div class="parameter-group">
                      <label class="param-label">NEGATIVE PROMPT</label>
                      <textarea
                        class="param-input small"
                        placeholder="What to avoid in generation..."></textarea>
                    </div>

                    <div class="parameter-row">
                      <div class="parameter-group">
                        <label class="param-label">NUM IMAGES</label>
                        <input
                          type="number"
                          class="param-input"
                          value="1"
                          min="1"
                          max="4"
                        />
                      </div>
                      <div class="parameter-group">
                        <label class="param-label">SEED</label>
                        <input
                          type="number"
                          class="param-input"
                          placeholder="Random (default: -1)"
                        />
                      </div>
                    </div>

                    <div class="parameter-group">
                      <label class="param-label">GUIDANCE SCALE</label>
                      <div class="slider-group">
                        <input
                          type="range"
                          class="param-slider"
                          min="0"
                          max="20"
                          step="0.5"
                          value="3.5"
                        />
                        <span class="slider-value">3.5</span>
                      </div>
                    </div>

                    <div class="parameter-group">
                      <label class="param-label">NUM INFERENCE STEPS</label>
                      <div class="slider-group">
                        <input
                          type="range"
                          class="param-slider"
                          min="20"
                          max="50"
                          step="1"
                          value="50"
                        />
                        <span class="slider-value">50</span>
                      </div>
                    </div>

                    <div class="parameter-group">
                      <label class="param-label">MODEL</label>
                      <select class="param-input">
                        <option>SDXL 1.0</option>
                        <option>Flux Dev</option>
                        <option>Aura Flow</option>
                        <option>SDXL Turbo</option>
                      </select>
                    </div>

                    <div class="checkbox-group">
                      <label class="checkbox-label">
                        <input type="checkbox" checked />
                        <span>Expand Prompt</span>
                      </label>
                      <label class="checkbox-label">
                        <input type="checkbox" />
                        <span>Sync Mode</span>
                      </label>
                    </div>
                  </div>
                </details>

                <!-- Action Buttons -->
                <div class="action-buttons">
                  <button class="reset-btn">
                    <span>RESET</span>
                  </button>
                  <button class="execute-btn">
                    <span class="btn-icon">▶</span>
                    <span>RUN</span>
                    <span class="shortcut">⌘↵</span>
                    <div class="execute-glow"></div>
                  </button>
                </div>
              </div>
            </div>

            <!-- Right Panel - Output -->
            <div class="workspace-panel output-panel">
              <div class="panel-content">
                <!-- Status Tabs -->
                <div class="output-tabs">
                  <button class="output-tab active">PREVIEW</button>
                  <button class="output-tab">LOGS</button>
                  <button class="output-tab">JSON</button>
                </div>

                <!-- Output Preview Area -->
                <div class="output-preview-area">
                  <div class="output-status">
                    <span class="status-badge idle">IDLE</span>
                    <span class="status-message">Waiting for your input...</span
                    >
                  </div>
                  <div class="output-placeholder-large">
                    <div class="placeholder-icon-large">◈</div>
                  </div>
                </div>

                <!-- JSON Output Display -->
                <div class="json-output">
                  <div class="json-header">
                    <span class="json-label">OUTPUT</span>
                    <button class="copy-btn">
                      <span>📋</span>
                      <span>COPY</span>
                    </button>
                  </div>
                  <pre
                    class="json-code"><code>&#123;
  "images": [],
  "seed": null,
  "has_nsfw_concepts": [],
  "prompt": ""
&#125;</code></pre>
                </div>

                <!-- Cost Info -->
                <div class="cost-info">
                  <span class="cost-label">COST:</span>
                  <span class="cost-value">$0.00</span>
                  <span class="cost-unit">per compute second</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Node Graph Tab -->
        <div class="tab-content" id="nodegraph-tab">
          <div class="node-graph-container">
            <div class="node-graph">
              <!-- Node connections visualization -->
              <svg class="connection-lines" width="100%" height="100%">
                <defs>
                  <linearGradient
                    id="lineGradient"
                    x1="0%"
                    y1="0%"
                    x2="100%"
                    y2="0%"
                  >
                    <stop offset="0%" style="stop-color:#00ff88;stop-opacity:1"
                    ></stop>
                    <stop
                      offset="100%"
                      style="stop-color:#00d9ff;stop-opacity:1"></stop>
                  </linearGradient>
                </defs>
                <path
                  d="M 50,80 Q 150,80 150,150"
                  stroke="url(#lineGradient)"
                  stroke-width="2"
                  fill="none"></path>
                <path
                  d="M 150,200 Q 150,250 250,250"
                  stroke="url(#lineGradient)"
                  stroke-width="2"
                  fill="none"></path>
                <path
                  d="M 300,250 Q 400,250 400,150"
                  stroke="url(#lineGradient)"
                  stroke-width="2"
                  fill="none"></path>
              </svg>

              <!-- Nodes -->
              <div class="node" style="top: 50px; left: 20px;">
                <div class="node-header">
                  <span class="node-dot"></span>
                  <span>LOAD IMAGE</span>
                </div>
                <div class="node-port output"></div>
              </div>

              <div class="node" style="top: 130px; left: 120px;">
                <div class="node-header">
                  <span class="node-dot"></span>
                  <span>CLIP TEXT ENCODE</span>
                </div>
                <div class="node-port input"></div>
                <div class="node-port output"></div>
              </div>

              <div class="node active" style="top: 220px; left: 220px;">
                <div class="node-header">
                  <span class="node-dot"></span>
                  <span>KSAMPLER</span>
                </div>
                <div class="node-port input"></div>
                <div class="node-port output"></div>
                <div class="node-status">PROCESSING...</div>
              </div>

              <div class="node" style="top: 130px; left: 370px;">
                <div class="node-header">
                  <span class="node-dot"></span>
                  <span>VAE DECODE</span>
                </div>
                <div class="node-port input"></div>
                <div class="node-port output"></div>
              </div>

              <div class="node" style="top: 220px; left: 470px;">
                <div class="node-header">
                  <span class="node-dot"></span>
                  <span>SAVE IMAGE</span>
                </div>
                <div class="node-port input"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- API Tab -->
        <div class="tab-content" id="api-tab">
          <div class="api-documentation">
            <div class="api-section">
              <h3 class="api-title">API ENDPOINT</h3>
              <div class="code-block">
                <code>https://api.cyber-ops.ai/v1/generate</code>
              </div>
            </div>
            <div class="api-section">
              <h3 class="api-title">AUTHENTICATION</h3>
              <p class="api-text">
                Include your API key in the Authorization header:
              </p>
              <div class="code-block">
                <code>Authorization: Bearer YOUR_API_KEY</code>
              </div>
            </div>
          </div>
        </div>

        <!-- Status Bar -->
        <div class="comfyui-status">
          <div class="status-left">
            <span class="status-dot active"></span>
            <span class="status-text">CONNECTED TO COMFYUI ENGINE</span>
          </div>
          <div class="status-right">
            <span class="status-item">QUEUE: 0</span>
            <span class="status-divider">|</span>
            <span class="status-item">GPU: RTX 4090</span>
            <span class="status-divider">|</span>
            <span class="status-item">VRAM: 8.2GB / 24GB</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Systems Section -->
  <section class="systems-section">
    <div class="section-container">
      <div class="section-header">
        <div class="header-line"></div>
        <span class="section-tag">[CORE_SYSTEMS]</span>
        <h2 class="section-title">INTEGRATED OPERATIONS</h2>
        <p class="section-subtitle">
          Advanced modules for complete system control
        </p>
      </div>

      <div class="systems-grid">
        <!-- System Card 1 -->
        <div class="system-card">
          <div class="card-border"></div>
          <div class="card-glow"></div>
          <div class="card-header">
            <div class="system-icon">
              <span class="material-symbols-rounded">terminal</span>
            </div>
            <div class="system-status">
              <span class="status-dot"></span>
              <span>ACTIVE</span>
            </div>
          </div>
          <h3 class="system-name">NEURAL INTERFACE</h3>
          <p class="system-desc">
            Advanced command-line integration with AI-assisted processing
          </p>
          <div class="tech-specs">
            <span class="spec">AI-POWERED</span>
            <span class="spec">REAL-TIME</span>
          </div>
        </div>

        <!-- System Card 2 -->
        <div class="system-card">
          <div class="card-border"></div>
          <div class="card-glow"></div>
          <div class="card-header">
            <div class="system-icon">
              <span class="material-symbols-rounded">memory</span>
            </div>
            <div class="system-status">
              <span class="status-dot"></span>
              <span>ACTIVE</span>
            </div>
          </div>
          <h3 class="system-name">QUANTUM STORAGE</h3>
          <p class="system-desc">
            Distributed data architecture with instant global synchronization
          </p>
          <div class="tech-specs">
            <span class="spec">DISTRIBUTED</span>
            <span class="spec">ENCRYPTED</span>
          </div>
        </div>

        <!-- System Card 3 -->
        <div class="system-card">
          <div class="card-border"></div>
          <div class="card-glow"></div>
          <div class="card-header">
            <div class="system-icon">
              <span class="material-symbols-rounded">speed</span>
            </div>
            <div class="system-status">
              <span class="status-dot"></span>
              <span>ACTIVE</span>
            </div>
          </div>
          <h3 class="system-name">HYPER DELIVERY</h3>
          <p class="system-desc">
            Edge-optimized content distribution with sub-millisecond latency
          </p>
          <div class="tech-specs">
            <span class="spec">EDGE-CDN</span>
            <span class="spec">< 1MS</span>
          </div>
        </div>

        <!-- System Card 4 -->
        <div class="system-card">
          <div class="card-border"></div>
          <div class="card-glow"></div>
          <div class="card-header">
            <div class="system-icon">
              <span class="material-symbols-rounded">psychology</span>
            </div>
            <div class="system-status">
              <span class="status-dot"></span>
              <span>ACTIVE</span>
            </div>
          </div>
          <h3 class="system-name">COGNITIVE ENGINE</h3>
          <p class="system-desc">
            Self-learning algorithms for automated workflow optimization
          </p>
          <div class="tech-specs">
            <span class="spec">ADAPTIVE</span>
            <span class="spec">AUTOMATED</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Terminal Section -->
  <section class="terminal-section">
    <div class="section-container">
      <div class="terminal-wrapper">
        <div class="terminal-border"></div>
        <div class="terminal-header">
          <div class="terminal-controls">
            <span class="control-dot dot-red"></span>
            <span class="control-dot dot-yellow"></span>
            <span class="control-dot dot-green"></span>
          </div>
          <div class="terminal-title">system_interface.sh</div>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="prompt">root@cyber-ops:~$</span>
            <span class="command">initialize --mode=production</span>
          </div>
          <div class="terminal-line output">
            <span class="success">[OK]</span> System initialized
          </div>
          <div class="terminal-line output">
            <span class="success">[OK]</span> Core modules loaded
          </div>
          <div class="terminal-line output">
            <span class="success">[OK]</span> Network interface established
          </div>
          <div class="terminal-line">
            <span class="prompt">root@cyber-ops:~$</span>
            <span class="cursor">_</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Data Grid Section - Sci-Fi Intelligence Dashboard -->
  <section class="data-grid-section">
    <div class="section-container">
      <div class="section-header">
        <div class="header-line"></div>
        <span class="section-tag">[ANALYTICS_MATRIX]</span>
        <h2 class="section-title">REAL-TIME INTELLIGENCE</h2>
      </div>

      <!-- Statistical Infographics Grid -->
      <div class="stats-infographic-grid">
        <!-- Large Data Panel -->
        <div class="info-panel large">
          <div class="panel-border animated-border"></div>
          <div class="panel-header">
            <span class="panel-icon">◆</span>
            <span class="panel-title">SYSTEM THROUGHPUT</span>
            <span class="status-indicator live">● LIVE</span>
          </div>
          <div class="panel-content">
            <div class="data-row">
              <span class="data-label">PROCESSED</span>
              <span class="data-value">15.7 <small>PB</small></span>
            </div>
            <div class="data-row">
              <span class="data-label">QUERIES/SEC</span>
              <span class="data-value">1.2M <small>OPS</small></span>
            </div>
            <div class="data-row">
              <span class="data-label">AVG LATENCY</span>
              <span class="data-value">342 <small>MS</small></span>
            </div>
            <div class="mini-chart">
              <div class="chart-bar" style="--height: 0.7"></div>
              <div class="chart-bar" style="--height: 0.85"></div>
              <div class="chart-bar" style="--height: 0.6"></div>
              <div class="chart-bar" style="--height: 0.9"></div>
              <div class="chart-bar" style="--height: 1.0"></div>
              <div class="chart-bar" style="--height: 0.75"></div>
              <div class="chart-bar" style="--height: 0.95"></div>
              <div class="chart-bar" style="--height: 0.8"></div>
            </div>
          </div>
        </div>

        <!-- Reliability Schematic -->
        <div class="info-panel schematic">
          <div class="panel-border"></div>
          <div class="panel-header">
            <span class="panel-icon">▣</span>
            <span class="panel-title">RELIABILITY MATRIX</span>
          </div>
          <div class="panel-content">
            <div class="reliability-display">
              <div class="reliability-value">
                99.99<span class="percent">%</span>
              </div>
              <div class="reliability-label">UPTIME</div>
            </div>
            <div class="schema-diagram">
              <div class="schema-line"></div>
              <div class="schema-line"></div>
              <div class="schema-line"></div>
              <div class="schema-node" style="--pos: 0.2">
                <span class="node-label">NODE_1</span>
              </div>
              <div class="schema-node" style="--pos: 0.5">
                <span class="node-label">NODE_2</span>
              </div>
              <div class="schema-node" style="--pos: 0.8">
                <span class="node-label">NODE_3</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Performance Table -->
        <div class="info-panel table-panel">
          <div class="panel-border"></div>
          <div class="panel-header">
            <span class="panel-icon">≡</span>
            <span class="panel-title">PERFORMANCE METRICS</span>
          </div>
          <div class="panel-content">
            <table class="data-table">
              <thead>
                <tr>
                  <th>METRIC</th>
                  <th>VALUE</th>
                  <th>STATUS</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>CPU</td>
                  <td>23.4%</td>
                  <td><span class="status-badge ok">OK</span></td>
                </tr>
                <tr>
                  <td>MEMORY</td>
                  <td>67.2%</td>
                  <td><span class="status-badge ok">OK</span></td>
                </tr>
                <tr>
                  <td>NETWORK</td>
                  <td>12.8 GB/s</td>
                  <td><span class="status-badge ok">OK</span></td>
                </tr>
                <tr>
                  <td>STORAGE</td>
                  <td>45.1 TB</td>
                  <td><span class="status-badge ok">OK</span></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- CTA Module -->
        <div class="info-panel cta-module">
          <div class="panel-border accent-border"></div>
          <div class="panel-content centered">
            <div class="cta-icon">⚡</div>
            <h3 class="cta-heading">OPTIMIZE PERFORMANCE</h3>
            <p class="cta-text">
              Deploy intelligent caching and edge computing
            </p>
            <div class="divider-line"></div>
            <button class="cta-btn-small">
              <span class="btn-arrow">→</span>
              <span>CONFIGURE</span>
            </button>
          </div>
        </div>

        <!-- Real-time Monitor -->
        <div class="info-panel monitor">
          <div class="panel-border"></div>
          <div class="panel-header">
            <span class="panel-icon">◉</span>
            <span class="panel-title">ACTIVE CONNECTIONS</span>
            <span class="monitor-count">4,829</span>
          </div>
          <div class="panel-content">
            <div class="connection-graph">
              <svg viewBox="0 0 200 80" class="graph-svg">
                <polyline
