  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const galleryItems = document.querySelectorAll('.gallery-item img');

      if (galleryItems.length > 0) {
        // Function to change a random image
        const changeRandomImage = () => {
          const randomIndex = Math.floor(Math.random() * galleryItems.length);
          const randomImage = galleryItems[randomIndex];
          const newRandom = Math.floor(Math.random() * 10000);

          // Get current dimensions from src
          const currentSrc = randomImage.src;
          const dimensions = currentSrc.match(/\/(\d+)\/(\d+)/);

          if (dimensions) {
            const width = dimensions[1];
            const height = dimensions[2];

            // Fade out
            randomImage.style.opacity = '0';

            setTimeout(() => {
              randomImage.src = `https://picsum.photos/${width}/${height}?random=${newRandom}`;

              // Fade in
              randomImage.style.opacity = '1';
            }, 300);
          }
        };

        // Change random image every 2 seconds
        setInterval(changeRandomImage, 2000);
      }
    });
  </script>

