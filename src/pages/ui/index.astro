---
import MainLayout from '../../layouts/MainLayout.astro';

const frameworks = [
  {
    slug: 'material-ui',
    title: 'Material UI',
    description: 'Modern ve popüler React UI framework'
  },
  {
    slug: 'm3.material-ui',
    title: 'm3.material-ui',
    description: 'Modern ve popüler React UI framework'
  },
  {
    slug: 'shadcn',
    title: 'ShadcnUI',
    description: 'Yeniden kullanılabilir güzel bileşenler'
  },
  {
    slug: 'daisy',
    title: 'DaisyUI',
    description: 'Tailwind CSS tabanlı bileşen kütüphanesi'
  },
  {
    slug: 'antd',
    title: 'Ant Design',
    description: 'Kurumsal düzeyde UI çözümleri'
  },
  {
    slug: 'mantine',
    title: 'Mantine',
    description: 'Modern ve özelleştirilebilir React bileşenleri'
  },
  {
    slug: 'custom',
    title: 'Custom UI',
    description: 'Özel tasarlanmış UI bileşenleri'
  }
];
---

<MainLayout title="UI Frameworks | Olcan Ebrem">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-8">UI Frameworks</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {frameworks.map(framework => (
        <a 
          href={`/ui/${framework.slug}`}
          class="block p-6 rounded-lg border border-gray-200 shadow-sm hover:shadow-md transition-shadow"
        >
          <h2 class="text-2xl font-semibold mb-4">{framework.title}</h2>
          <p class="text-gray-600">{framework.description}</p>
          <div class="mt-4 text-blue-600">Detayları gör →</div>
        </a>
      ))}
    </div>
  </main>
</MainLayout>
