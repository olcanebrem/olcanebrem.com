---
import MainLayout from '../../layouts/MainLayout.astro';
import { ShadcnLayout } from '@/components/ui/shadcn/shadcn-layout';
import { MantineDemo } from '@/components/ui/mantine/MantineDemo';
import { MaterialDemo } from '@/components/ui/material/MaterialDemo';

interface Framework {
  title: string;
  description: string;
  docsUrl: string;
}

type Frameworks = {
  [key: string]: Framework;
};

export function getStaticPaths() {
  return [
    { params: { slug: 'shadcn' } },
    { params: { slug: 'material-ui' } },
    { params: { slug: 'daisy' } },
    { params: { slug: 'mantine' } },
  ];
}

const frameworks: Frameworks = {
  shadcn: {
    title: 'Shadcn UI',
    description: 'Beautifully designed components built with Radix UI and Tailwind CSS.',
    docsUrl: 'https://ui.shadcn.com',
  },
  'material-ui': {
    title: 'Material UI',
    description: 'MUI offers a comprehensive suite of UI tools to help you ship new features faster.',
    docsUrl: 'https://mui.com',
  },
  daisy: {
    title: 'DaisyUI',
    description: 'The most popular component library for Tailwind CSS.',
    docsUrl: 'https://daisyui.com',
  },
  mantine: {
    title: 'Mantine',
    description: 'A fully featured React components library.',
    docsUrl: 'https://mantine.dev',
  },
};

const { slug } = Astro.params;
const framework: Framework = frameworks[slug as keyof typeof frameworks] || {
  title: 'Unknown Framework',
  description: 'Framework not found',
  docsUrl: '/',
};
---

<MainLayout title={`${framework.title} | UI Frameworks | Olcan Ebrem`}>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-4">{framework.title}</h1>
      <p class="text-gray-600 mb-4">{framework.description}</p>
      <a href={framework.docsUrl} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
        Dokümantasyon →
      </a>
    </div>

    {slug === 'shadcn' ? (
      <ShadcnLayout client:load title={framework.title} description={framework.description} />
    ) : slug === 'material-ui' ? (
      <MaterialDemo client:load />
    ) : slug === 'mantine' ? (
      <MantineDemo client:load />
    ) : slug === 'daisy' ? (
      <div class="p-4">
        <p class="text-gray-600">DaisyUI örnekleri yakında eklenecek...</p>
      </div>
    ) : (
      <div class="p-4">
        <p class="text-gray-600">Framework bulunamadı.</p>
      </div>
    )}
</MainLayout>