---
import MainLayout from '../../layouts/MainLayout.astro';
import { ShadcnLayout } from '@/components/ui/shadcn-layout';
import { AntLayout } from '@/components/ui/antd-layout';
import 'antd/dist/reset.css';

export function getStaticPaths() {
  return [
  {
      params: { slug: 'material-ui' },
      props: { 
        title: 'Material UI',
        description: 'Modern ve popüler React UI framework',
        docsUrl: 'https://mui.com'
      },
    },
    {
      params: { slug: 'm3.material-ui' },
      props: { 
        title: 'm3.material-ui',
        description: 'Modern ve popüler React UI framework',
        docsUrl: 'https://m3.material.io'
      },
    },
    {
      params: { slug: 'daisy' },
      props: {
        title: 'DaisyUI',
        description: 'Tailwind CSS tabanlı bileşen kütüphanesi',
        docsUrl: 'https://daisyui.com'
      },
    },
    {
      params: { slug: 'antd' },
      props: {
        title: 'Ant Design',
        description: 'Kurumsal düzeyde UI çözümleri',
        docsUrl: 'https://ant.design'
      },
    },
    {
      params: { slug: 'shadcn' },
      props: {
        title: 'shadcn/ui',
        description: 'Yeniden kullanılabilir React bileşenleri',
        docsUrl: 'https://ui.shadcn.com'
      },
    },
    {
      params: { slug: 'mantine' },
      props: {
        title: 'Mantine',
        description: 'Modern ve özelleştirilebilir React bileşenleri',
        docsUrl: 'https://mantine.dev'
      },
    },
    {
      params: { slug: 'custom' },
      props: {
        title: 'Custom UI',
        description: 'Özel tasarlanmış UI bileşenleri',
        docsUrl: '#'
      },
    },
  ];
}

const { slug } = Astro.params;
const { title, description, docsUrl } = Astro.props;
---

<MainLayout title={`${title} | UI Frameworks | Olcan Ebrem`}>
  <main class="container mx-auto px-4 py-8">
    <nav class="mb-8">
      <a href="/ui" class="text-blue-600 hover:underline">← Tüm UI Frameworks</a>
    </nav>

    {Astro.params.slug === 'shadcn' ? (
      <ShadcnLayout client:load title={title} description={description} />
    ) : Astro.params.slug === 'antd' ? (
      <AntLayout client:load title={title} description={description} />
    ) : (
      <div class="container mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold mb-4">{title}</h1>
        <p class="text-gray-600 dark:text-gray-400 mb-8">{description}</p>
        <a
          href={docsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-500 hover:text-blue-600 dark:text-blue-400 dark:hover:text-blue-500"
        >
          Dokümantasyon &rarr;
        </a>
      </div>
    )}

    <article class="prose prose-lg max-w-none">
      <h1 class="text-4xl font-bold mb-4">{title}</h1>
      <p class="text-xl text-gray-600 mb-8">{description}</p>

      <div class="dark:bg-gray-800bg-white p-6 rounded-lg border border-gray-200 shadow-sm">
        <h2 class="text-2xl font-semibold mb-4">Özellikler</h2>
        <div class="space-y-4">
          {slug === 'material-ui' && (
            <>
              <p>Material UI, Google'ın Material Design prensiplerini temel alan popüler bir React UI framework'üdür.</p>
              <ul class="list-disc list-inside">
                <li>Kapsamlı bileşen kütüphanesi</li>
                <li>Material Design uyumlu</li>
                <li>Özelleştirilebilir tema sistemi</li>
                <li>TypeScript desteği</li>
              </ul>
            </>
          )}

          {slug === 'm3.material-ui' && (
            <>
              <div class="theme-default" id="themeContainer">
                <div class="mb-8 p-4 border rounded-lg bg-surface text-on-surface">
                  <h3 class="text-xl font-semibold mb-4">Tema Seçici</h3>
                  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
                    {['default', 'dark', 'nature', 'ocean', 'sunset'].map((theme) => (
                      <button 
                        class="p-4 rounded-lg border hover:shadow-lg transition-all bg-surface text-on-surface"
                        onclick={`document.getElementById('themeContainer').className = 'theme-${theme}'`}
                        style={`--theme-preview-color: var(--md-sys-color-primary);`}
                      >
                        <div class="aspect-square rounded-lg mb-2" style={`background-color: var(--md-sys-color-primary);`}></div>
                        <div class="text-sm font-medium capitalize">{theme}</div>
                      </button>
                    ))}
                  </div>
                </div>

                <div class="mb-8">
                  <h3 class="text-xl font-semibold mb-4">Tema Token Örnekleri</h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-6 p-4 rounded-lg border">
                      <div>
                        <h4 class="font-medium mb-3">Renkler</h4>
                        <div class="grid grid-cols-2 gap-2">
                          {[
                            'primary',
                            'on-primary',
                            'primary-container',
                            'on-primary-container',
                            'secondary',
                            'on-secondary',
                            'secondary-container',
                            'on-secondary-container',
                          ].map((color) => (
                            <div class="flex items-center space-x-2">
                              <div 
                                class="w-6 h-6 rounded"
                                style={`background-color: var(--md-sys-color-${color});`}
                              ></div>
                              <span class="text-sm">{color}</span>
                            </div>
                          ))}
                        </div>
                      </div>

                      <div>
                        <h4 class="font-medium mb-3">Köşe Yuvarlaklığı</h4>
                        <div class="grid grid-cols-3 sm:grid-cols-4 gap-4">
                          {[
                            'none',
                            'extra-small',
                            'small',
                            'medium',
                            'large',
                            'extra-large',
                            'full'
                          ].map((radius) => (
                            <div class="text-center">
                              <div 
                                class="bg-primary mb-2 aspect-square mx-auto w-12"
                                style={`border-radius: var(--md-sys-shape-corner-${radius});`}
                              ></div>
                              <span class="text-xs">{radius}</span>
                            </div>
                          ))}
                        </div>
                      </div>

                      <div>
                        <h4 class="font-medium mb-3">Yükseklik</h4>
                        <div class="grid grid-cols-5 gap-4 items-end h-32">
                          {[1, 2, 3, 4, 5].map((level) => (
                            <div class="text-center">
                              <div 
                                class="bg-primary w-full rounded"
                                style={`height: ${level * 20}%; box-shadow: var(--md-sys-elevation-level${level});`}
                              ></div>
                              <span class="text-xs mt-1 block">Level {level}</span>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>

                    <div class="space-y-6 p-4 rounded-lg border">
                      <div>
                        <h4 class="font-medium mb-3">Tipografi</h4>
                        <div class="space-y-4">
                          {[
                            'display-large',
                            'display-medium',
                            'display-small',
                            'headline-large',
                            'headline-medium',
                            'headline-small',
                            'body-large',
                            'body-medium',
                            'body-small'
                          ].map((type) => (
                            <div>
                              <div 
                                style={`
                                  font-family: var(--md-sys-typescale-font-family-brand);
                                  font-size: var(--md-sys-typescale-${type}-size);
                                `}
                              >
                                {type}
                              </div>
                            </div>
                          ))}
                        </div>
                      </div>

                      <div>
                        <h4 class="font-medium mb-3">Hareket</h4>
                        <div class="space-y-4">
                          {['short', 'medium', 'long'].map((duration) => (
                            <div>
                              <div class="text-sm mb-1">{duration}</div>
                              <div 
                                class="h-2 bg-primary rounded-full w-0 hover:w-full"
                                style={`transition: width var(--md-sys-motion-duration-${duration}) var(--md-sys-motion-easing-standard);`}
                              ></div>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <p class="text-on-surface">Material Design 3 (M3), Google'ın en yeni tasarım sistemi olup, modern ve adaptif UI deneyimi sunar.</p>
              <div class="space-y-12">
                <section>
                  <h3 class="text-xl font-semibold mb-6">Etkileşimli Bileşenler</h3>
                  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="p-4 border rounded-lg hover:shadow-lg transition-shadow">
                      <h4 class="font-medium mb-4">Buttons & Chips</h4>
                      <div class="space-y-4">
                        <div class="space-y-2">
                          <button class="w-full bg-primary text-white px-4 py-2 rounded-full hover:bg-primary/90 transition-colors">
                            Filled Button
                          </button>
                          <button class="w-full border-2 border-primary text-primary px-4 py-2 rounded-full hover:bg-primary/10 transition-colors">
                            Outlined Button
                          </button>
                          <button class="w-full text-primary hover:bg-primary/10 px-4 py-2 rounded-full transition-colors">
                            Text Button
                          </button>
                        </div>
                        <div class="flex flex-wrap gap-2">
                          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-blue-100 text-blue-800 hover:bg-blue-200 transition-colors cursor-pointer">
                            Chip 1 ✕
                          </span>
                          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-purple-100 text-purple-800 hover:bg-purple-200 transition-colors cursor-pointer">
                            Chip 2 ✕
                          </span>
                          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-green-100 text-green-800 hover:bg-green-200 transition-colors cursor-pointer">
                            Chip 3 ✕
                          </span>
                        </div>
                      </div>
                    </div>

                    <div class="p-4 border rounded-lg hover:shadow-lg transition-shadow">
                      <h4 class="font-medium mb-4">Dropdown & Select</h4>
                      <div class="space-y-4">
                        <div class="relative">
                          <button 
                            class="w-full flex items-center justify-between px-4 py-2 border rounded-lg hover:bg-gray-50 transition-colors"
                            onclick="this.nextElementSibling.classList.toggle('hidden')"
                          >
                            Seçenekler
                            <span>▾</span>
                          </button>
                          <div class="hidden absolute z-10 w-full mt-1 bg-white border rounded-lg shadow-lg">
                            <div class="p-2 hover:bg-gray-50 cursor-pointer">Seçenek 1</div>
                            <div class="p-2 hover:bg-gray-50 cursor-pointer">Seçenek 2</div>
                            <div class="p-2 hover:bg-gray-50 cursor-pointer">Seçenek 3</div>
                          </div>
                        </div>
                        <select class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary">
                          <option>Liste Seçeneği 1</option>
                          <option>Liste Seçeneği 2</option>
                          <option>Liste Seçeneği 3</option>
                        </select>
                      </div>
                    </div>

                    <div class="p-4 border rounded-lg hover:shadow-lg transition-shadow">
                      <h4 class="font-medium mb-4">Toggle & Switch</h4>
                      <div class="space-y-4">
                        <label class="flex items-center space-x-2 cursor-pointer">
                          <div class="relative">
                            <input type="checkbox" class="sr-only peer">
                            <div class="w-11 h-6 bg-gray-200 rounded-full peer peer-checked:after:translate-x-full peer-checked:bg-primary after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all">
                            </div>
                          </div>
                          <span>Toggle Switch</span>
                        </label>
                        <div class="flex items-center space-x-4">
                          <label class="inline-flex items-center cursor-pointer">
                            <input type="radio" name="radio" class="h-4 w-4 text-primary">
                            <span class="ml-2">Seçenek A</span>
                          </label>
                          <label class="inline-flex items-center cursor-pointer">
                            <input type="radio" name="radio" class="h-4 w-4 text-primary">
                            <span class="ml-2">Seçenek B</span>
                          </label>
                        </div>
                      </div>
                    </div>
                  </div>
                </section>

                <section>
                  <h3 class="text-xl font-semibold mb-6">Kartlar ve Gridler</h3>
                  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="col-span-2">
                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        {[1, 2, 3, 4].map(() => (
                          <div class="bg-white rounded-xl p-4 border hover:shadow-lg transition-all cursor-pointer transform hover:-translate-y-1">
                            <div class="aspect-video rounded-lg bg-gray-200 mb-4 overflow-hidden">
                              <img 
                                src="https://picsum.photos/400/225" 
                                alt="Random image"
                                class="w-full h-full object-cover hover:scale-110 transition-transform duration-300"
                              />
                            </div>
                            <h5 class="font-medium mb-2">Kart Başlığı</h5>
                            <p class="text-gray-600 text-sm">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
                            <div class="mt-4 flex justify-between items-center">
                              <button class="text-primary hover:text-primary/80">Detaylar</button>
                              <div class="flex space-x-2">
                                <button class="p-2 hover:bg-gray-100 rounded-full">❤️</button>
                                <button class="p-2 hover:bg-gray-100 rounded-full">👍</button>
                              </div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div class="space-y-4">
                      <div class="bg-white rounded-xl p-4 border hover:shadow-lg transition-shadow">
                        <h4 class="font-medium mb-4">Yükleniyor Durumu</h4>
                        <div class="space-y-4">
                          <div class="animate-pulse flex space-x-4">
                            <div class="rounded-full bg-gray-200 h-12 w-12"></div>
                            <div class="flex-1 space-y-2 py-1">
                              <div class="h-4 bg-gray-200 rounded w-3/4"></div>
                              <div class="space-y-2">
                                <div class="h-3 bg-gray-200 rounded"></div>
                                <div class="h-3 bg-gray-200 rounded w-5/6"></div>
                              </div>
                            </div>
                          </div>
                          <div class="animate-pulse flex space-x-4">
                            <div class="rounded-full bg-gray-200 h-12 w-12"></div>
                            <div class="flex-1 space-y-2 py-1">
                              <div class="h-4 bg-gray-200 rounded w-1/2"></div>
                              <div class="space-y-2">
                                <div class="h-3 bg-gray-200 rounded w-3/4"></div>
                                <div class="h-3 bg-gray-200 rounded w-2/3"></div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div class="bg-white rounded-xl p-4 border hover:shadow-lg transition-shadow">
                        <h4 class="font-medium mb-4">Hızlı İşlemler</h4>
                        <div class="space-y-2">
                          <button class="w-full flex items-center justify-between p-2 hover:bg-gray-50 rounded-lg transition-colors group">
                            <span>Yeni Oluştur</span>
                            <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span>
                          </button>
                          <button class="w-full flex items-center justify-between p-2 hover:bg-gray-50 rounded-lg transition-colors group">
                            <span>Paylaş</span>
                            <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span>
                          </button>
                          <button class="w-full flex items-center justify-between p-2 hover:bg-gray-50 rounded-lg transition-colors group">
                            <span>Düzenle</span>
                            <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span>
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </section>

                <section>
                  <h3 class="text-xl font-semibold mb-6">Veri Görüntüleme</h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-white rounded-xl p-4 border hover:shadow-lg transition-shadow">
                      <div class="flex justify-between items-center mb-4">
                        <h4 class="font-medium">Liste Görünümü</h4>
                        <button class="p-2 hover:bg-gray-100 rounded-full">⋮</button>
                      </div>
                      <div class="divide-y">
                        {[1, 2, 3, 4].map((i) => (
                          <div class="py-3 flex items-center justify-between hover:bg-gray-50 -mx-4 px-4 cursor-pointer group">
                            <div class="flex items-center space-x-3">
                              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                                {i}
                              </div>
                              <div>
                                <div class="font-medium">Öğe {i}</div>
                                <div class="text-sm text-gray-500">Açıklama metni</div>
                              </div>
                            </div>
                            <button class="opacity-0 group-hover:opacity-100 transition-opacity text-gray-500 hover:text-gray-700">
                              →
                            </button>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div class="bg-white rounded-xl p-4 border hover:shadow-lg transition-shadow">
                      <div class="flex justify-between items-center mb-4">
                        <h4 class="font-medium">Grid Görünümü</h4>
                        <div class="flex space-x-2">
                          <button class="p-2 hover:bg-gray-100 rounded-full">🔍</button>
                          <button class="p-2 hover:bg-gray-100 rounded-full">🔄</button>
                        </div>
                      </div>
                      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                        {[1, 2, 3, 4, 5, 6].map(() => (
                          <div class="aspect-square rounded-lg bg-gray-100 flex items-center justify-center hover:bg-gray-200 cursor-pointer transition-colors relative group">
                            <span class="text-4xl text-gray-400">📄</span>
                            <div class="absolute inset-0 bg-black/50 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                              <div class="text-white text-sm">Görüntüle</div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </section>
              </div>

                <section class="mt-8">
                  <h3 class="text-xl font-semibold mb-6">Hareket ve Animasyonlar</h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-6 p-4 rounded-lg border">
                      <div>
                        <h4 class="font-medium mb-4">Standart Hareket</h4>
                        <div class="space-y-6">
                          {/* Fade */}
                          <div>
                            <div class="text-sm mb-2">Fade (Solma)</div>
                            <button 
                              class="w-full p-4 bg-primary text-on-primary rounded-lg transition-all duration-300"
                              onclick="this.classList.toggle('opacity-0')"
                            >
                              Tıkla ve Kaybol
                            </button>
                          </div>

                          {/* Scale */}
                          <div>
                            <div class="text-sm mb-2">Scale (Büyütme)</div>
                            <button 
                              class="w-full p-4 bg-primary text-on-primary rounded-lg transition-all duration-300 hover:scale-105 active:scale-95"
                            >
                              Hover ve Tıkla
                            </button>
                          </div>

                          {/* Slide */}
                          <div>
                            <div class="text-sm mb-2">Slide (Kaydırma)</div>
                            <div class="relative h-16 overflow-hidden">
                              <button 
                                class="w-full p-4 bg-primary text-on-primary rounded-lg transition-all duration-300 absolute inset-x-0"
                                onclick="this.style.transform = this.style.transform ? '' : 'translateX(120%)';"
                              >
                                Sağa Kaydır
                              </button>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div>
                        <h4 class="font-medium mb-4">Vurgulu Hareket</h4>
                        <div class="space-y-6">
                          {/* Emphasized Scale */}
                          <div>
                            <div class="text-sm mb-2">Vurgulu Büyütme</div>
                            <button 
                              class="w-full p-4 bg-primary text-on-primary rounded-lg transition-all duration-500"
                              onclick="this.classList.toggle('scale-110')"
                              style="transition-timing-function: cubic-bezier(0.2, 0, 0, 1);"
                            >
                              Tıkla ve Büyüt
                            </button>
                          </div>

                          {/* Container Transform */}
                          <div>
                            <div class="text-sm mb-2">Kap Transformu</div>
                            <div class="relative h-32">
                              <button 
                                class="w-full h-16 bg-primary text-on-primary rounded-lg transition-all duration-400"
                                onclick="this.classList.toggle('h-32'); this.classList.toggle('rounded-3xl');"
                                style="transition-timing-function: cubic-bezier(0.2, 0, 0, 1);"
                              >
                                Tıkla ve Genişlet
                              </button>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="space-y-6 p-4 rounded-lg border">
                      <div>
                        <h4 class="font-medium mb-4">Karmaşık Animasyonlar</h4>
                        <div class="space-y-6">
                          {/* FAB Transform */}
                          <div>
                            <div class="text-sm mb-2">FAB Dönüşümü</div>
                            <button 
                              class="w-14 h-14 bg-primary text-on-primary rounded-full flex items-center justify-center transition-all duration-300 hover:w-full group"
                              style="transition-timing-function: cubic-bezier(0.2, 0, 0, 1);"
                            >
                              <span class="text-2xl group-hover:hidden">+</span>
                              <span class="hidden group-hover:inline">Yeni Öğe Ekle</span>
                            </button>
                          </div>

                          {/* Card Expand */}
                          <div>
                            <div class="text-sm mb-2">Kart Genişlemesi</div>
                            <div 
                              class="bg-surface border rounded-lg transition-all duration-500 cursor-pointer overflow-hidden"
                              onclick="this.classList.toggle('expanded')"
                              style="transition-timing-function: cubic-bezier(0.2, 0, 0, 1);"
                            >
                              <div class="p-4">
                                <h5 class="font-medium">Genişleyen Kart</h5>
                                <p class="text-sm text-on-surface-variant mt-1 expanded-content hidden">
                                  Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
                                </p>
                              </div>
                            </div>
                          </div>

                          {/* List Reorder */}
                          <div>
                            <div class="text-sm mb-2">Liste Yeniden Sıralama</div>
                            <div class="space-y-2" id="reorderList">
                              {[1, 2, 3].map((i) => (
                                <div 
                                  class="p-4 bg-surface border rounded-lg flex items-center justify-between cursor-move transition-all duration-300"
                                  draggable="true"
                                >
                                  <span>Öğe {i}</span>
                                  <span class="text-on-surface-variant">☰</span>
                                </div>
                              ))}
                            </div>
                          </div>
                        </div>
                      </div>

                      <div>
                        <h4 class="font-medium mb-4">Zamanlama Fonksiyonları</h4>
                        <div class="space-y-4">
                          {/* Standard Easing */}
                          <div>
                            <div class="text-sm mb-2">Standart (cubic-bezier(0.2, 0, 0, 1))</div>
