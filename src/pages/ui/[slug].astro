---
import MainLayout from '../../layouts/MainLayout.astro';
import { ShadcnLayout } from '@/components/ui/shadcn/shadcn-layout';
import { MantineDemo } from '@/components/ui/mantine/MantineDemo';
import { MaterialDemo } from '@/components/ui/material/MaterialDemo';
import MaterialWebComponentsDemo from '../../components/ui/MWC/MWCcomp.astro';
import { MaterialNextDemo } from '@/components/ui/material-next/MaterialNextDemo';
import { MuiXDataGrid } from '@/components/ui/MUI_X/MuiXDataGrid';
import { frameworks } from './frameworks';


export function getStaticPaths() {
  return [
    { params: { slug: 'shadcn' } },
    { params: { slug: 'materialui' } },
    { params: { slug: 'daisy' } },
    { params: { slug: 'mantine' } },
    { params: { slug: 'mwc' } },
    { params: { slug: 'material-next' } },
    { params: { slug: 'mui-x' } },
  ];
}

const { slug } = Astro.params;
const framework = frameworks.find(f => f.slug === slug) || {
  title: 'Unknown Framework',
  description: 'Framework not found',
  docsUrl: '/',
};
---

<MainLayout title={`${framework.title} | UI Frameworks | Olcan Ebrem`}>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-4">{framework.title}</h1>
      <p class="text-gray-600 mb-4">{framework.description}</p>
      <a href={framework.docsUrl} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
        Dokümantasyon →
      </a>
    </div>

    {slug === 'shadcn' ? (
      <ShadcnLayout client:load title={framework.title} description={framework.description} />
    ) : slug === 'materialui' ? (
      <MaterialDemo client:only="react" />
    ) : slug === 'mantine' ? (
      <MantineDemo client:only="react" />
    ) : slug === 'mwc' ? (
      <MaterialWebComponentsDemo />
    ) : slug === 'material-next' ? (
      <MaterialNextDemo client:only="react" />
    ) : slug === 'daisy' ? (
      <div class="p-4">
        <p class="text-gray-600">DaisyUI örnekleri yakında eklenecek...</p>
      </div>
    ) : slug === 'mui-x' ? (
      <div class="p-4">
        <MuiXDataGrid client:only="react" />
      </div>
    ) : (
      <div class="p-4">
        <p class="text-gray-600">Framework bulunamadı.</p>
      </div>
    )}
  </main>
</MainLayout>