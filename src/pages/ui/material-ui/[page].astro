            color: var(--md-sys-color-on-surface);
            font-size: 0.75rem;
            border-radius: 4px;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            transition: all 0.2s ease;
            box-shadow: var(--md-sys-elevation-level1);
            z-index: 1000;
          }

          .fab-item md-fab:hover::before {
            opacity: 1;
