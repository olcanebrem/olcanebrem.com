<!-- Material Web Components için importmap (CDN) -->
<script type="importmap">
  {
    "imports": {
      "@material/web/": "https://esm.run/@material/web/",
      "@material/web/icon/": "https://esm.run/@material/web/icon/"
    }
  }
</script>

<!-- Material Web Components ve stilleri yükle (CDN) -->
<script type="module">
  import '@material/web/all.js';
  import { styles as typescaleStyles } from '@material/web/typography/md-typescale-styles.js';
  document.adoptedStyleSheets.push(typescaleStyles.styleSheet);
</script>

<MainLayout title={`${pageTitle} - Sayfa ${currentPage}`}>
  <div class="web-components-page" data-page-content>
    <header class="page-header">
      <h1>{pageTitle}</h1>
      <p class="page-description">
        Material Design 3 Web Components (MWC) ile oluşturulmuş interaktif UI bileşen örnekleri.
        Her bileşen, Material Design 3 prensiplerine uygun olarak tasarlanmıştır.
      </p>
    </header>

    <!-- Bileşen Grid'i -->
    <div class="components-grid">
      {pageComponents.map(component => (
        <article class="component-card" id={`component-${component.id}`} data-loading-component>
          <div class="loading-bar">
            <div class="loading-bar-progress"></div>
          </div>
          <header class="component-card-header">
            <h2>{component.name}</h2>
            {component.m3Link && (
              <a href={component.m3Link} target="_blank" rel="noopener noreferrer" class="m3-link" title="Resmi M3 Dokümantasyonu">
                <md-icon>open_in_new</md-icon> M3 Docs
              </a>
            )}
          </header>
          {component.description && <p class="component-description">{component.description}</p>}
          <div class="component-content" set:html={component.content} />
        </article>
      ))}
    </div>

    <!-- Sayfalama -->
    {props.totalPages > 1 && (
      <Pagination 
        currentPage={currentPage}
        totalPages={props.totalPages}
        baseUrl="/ui/material-ui"
      />
    )}
  </div>
</MainLayout>

