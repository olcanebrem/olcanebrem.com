  ];

  const totalComponents = components.length;
  const totalPages = Math.ceil(totalComponents / ITEMS_PER_PAGE);
  
  const paths: GetStaticPathsItem[] = Array.from({ length: totalPages }, (_, i) => {
    const page = i + 1;
    return {
      params: { page: page.toString() },
      props: {
        currentPage: page,
        components: components.slice((page - 1) * ITEMS_PER_PAGE, page * ITEMS_PER_PAGE),
        totalPages
      } satisfies PageProps
    };
  });

  return paths;
}

const pageTitle = "Material Design 3 Web Component Örnekleri";

// Get current page from URL params or props
const { page } = Astro.params;
const props = Astro.props as unknown as PageProps;
const currentPage = props.currentPage || Number(page) || 1;

// Validate page number
if (isNaN(currentPage) || currentPage < 1 || currentPage > props.totalPages && props.totalPages > 0) {
  return Astro.redirect('/ui/material-ui/1');
}

// Get components for current page
const pageComponents = props.components;
