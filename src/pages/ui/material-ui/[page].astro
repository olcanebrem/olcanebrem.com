---
import MainLayout from "@/layouts/MainLayout.astro";
import type { GetStaticPathsResult, GetStaticPathsItem } from "astro";
import type { PageProps } from '@/types/web-components';
import Pagination from '@/components/ui/Pagination.astro';

// Component interface - simplified for this page
interface Component {
  id: string;
  name: string;
  type: string;
  content: string;
  description?: string;
  m3Link?: string;
}

// Props type for the page
interface PageProps {
  currentPage: number;
  components: Component[];
  totalPages: number;
}

// Statik sayfaları oluştur
export async function getStaticPaths(): Promise<GetStaticPathsResult> {
  // Constants moved inside getStaticPaths
  const ITEMS_PER_PAGE = 6;

  // Clock markers for analog clock
  const clockMarkers = Array.from({ length: 12 }, (_, i) => {
    const angle = (i * 30) * (Math.PI / 180);
    const x = 50 + 40 * Math.sin(angle);
    const y = 50 - 40 * Math.cos(angle);
    return `<div class="hour-marker" style="left: ${x}%; top: ${y}%;">${i === 0 ? 12 : i}</div>`;
  }).join("");

  // Components array
  const components: Component[] = [
    // FAB Grid Component - Basic Variants
    {
      id: "fab-grid-basic",
      name: "FAB Grid - Basic Variants",
      type: "md-fab",
      content: `
        <div class="fab-grid-container">
          <div class="fab-grid">
            <!-- Primary FABs -->
            <div class="fab-item">
              <md-fab aria-label="Add" data-tooltip="Primary FAB">
                <md-icon slot="icon">add</md-icon>
              </md-fab>
              <span class="fab-label">Primary</span>
            </div>

            <div class="fab-item">
              <md-fab aria-label="Edit" style="--md-fab-container-color: var(--md-sys-color-secondary-container);" data-tooltip="Secondary FAB">
                <md-icon slot="icon">edit</md-icon>
              </md-fab>
              <span class="fab-label">Secondary</span>
            </div>

            <div class="fab-item">
              <md-fab aria-label="Favorite" style="--md-fab-container-color: var(--md-sys-color-tertiary-container);" data-tooltip="Tertiary FAB">
                <md-icon slot="icon">favorite</md-icon>
              </md-fab>
              <span class="fab-label">Tertiary</span>
            </div>

            <!-- Size Variants -->
            <div class="fab-item">
              <md-fab size="small" aria-label="Small" data-tooltip="Small FAB">
                <md-icon slot="icon">add</md-icon>
              </md-fab>
              <span class="fab-label">Small</span>
            </div>

            <div class="fab-item">
              <md-fab size="large" aria-label="Large" data-tooltip="Large FAB">
                <md-icon slot="icon">add</md-icon>
              </md-fab>
              <span class="fab-label">Large</span>
            </div>

            <!-- Extended FABs -->
            <div class="fab-item">
              <md-fab label="Create" aria-label="Create" data-tooltip="Extended FAB with label">
                <md-icon slot="icon">add</md-icon>
              </md-fab>
              <span class="fab-label">Extended</span>
            </div>

            <div class="fab-item">
              <md-fab label="Share" aria-label="Share" style="--md-fab-container-color: var(--md-sys-color-secondary-container);" data-tooltip="Extended Secondary FAB">
                <md-icon slot="icon">share</md-icon>
              </md-fab>
              <span class="fab-label">Extended Secondary</span>
            </div>
          </div>
        </div>

        <style>
          .fab-grid-container {
            padding: 2rem;
            background: var(--md-sys-color-surface-container-low);
            border-radius: 1rem;
          }

          .fab-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 2rem;
            justify-items: center;
          }

          .fab-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            position: relative;
          }

          .fab-label {
            font-size: 0.875rem;
            color: var(--md-sys-color-on-surface-variant);
            text-align: center;
          }

          /* FAB hover effects */
          .fab-item md-fab {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
          }

          .fab-item md-fab:hover {
            transform: translateY(-4px) scale(1.1);
            box-shadow: var(--md-sys-elevation-level3);
          }

          /* Tooltip styles */
          .fab-item md-fab::before {
            content: attr(data-tooltip);
            position: absolute;
            bottom: 100%;
            left: 50%;
            transform: translateX(-50%) translateY(-8px);
            padding: 4px 8px;
            background: var(--md-sys-color-surface-container-high);
            color: var(--md-sys-color-on-surface);
            font-size: 0.75rem;
            border-radius: 4px;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            transition: all 0.2s ease;
            box-shadow: var(--md-sys-elevation-level1);
            z-index: 1000;
          }

          .fab-item md-fab:hover::before {
            opacity: 1;
            visibility: visible;
            transform: translateX(-50%) translateY(-4px);
          }

          /* Ripple effect */
          .fab-item md-fab::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: radial-gradient(circle at center, var(--md-sys-color-primary) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.3s ease;
          }

          .fab-item md-fab:hover::after {
            opacity: 0.1;
          }

          /* Responsive adjustments */
          @media (max-width: 600px) {
            .fab-grid {
              grid-template-columns: repeat(2, 1fr);
              gap: 1rem;
            }

            .fab-label {
              font-size: 0.75rem;
            }
          }
        </style>
      `,
      description: "Material Design 3 FAB temel varyantları. Primary, secondary, tertiary, boyut varyantları ve extended FAB örnekleri.",
      m3Link: "https://m3.material.io/components/floating-action-button/overview"
    },
    // FAB Grid Component - Advanced Variants
    {
      id: "fab-grid-advanced",
