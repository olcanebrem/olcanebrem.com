---
import MainLayout from '@/layouts/MainLayout.astro';
import GSAPAnimations from '@/components/ui/GSAP/GSAPAnimations';
import AnimatedComponent from '@/components/ui/GSAP/AnimatedComponent';
import PageTransition from '@/components/ui/GSAP/PageTransition';
---

<style>
  main {
    view-transition-name: page-content;
  }
</style>

<MainLayout title="GSAP Animations Demo">
  <main class="container mx-auto p-8">
    <h1 class="text-4xl font-bold mb-8">GSAP Animation Showcase</h1>
    <PageTransition client:load>
      <GSAPAnimations client:load />
      <AnimatedComponent client:load />
    </PageTransition>
  </main>
</MainLayout>
